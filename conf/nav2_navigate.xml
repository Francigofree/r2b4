<!-- RC recovery is selected from the fresh local costmap by the existing ROS
     bridge. Native actions retain the stamped ROS -> V3 L6 -> L12 path. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="2.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
      </RateController>
      <!-- Action ACK budget only: tolerate a bounded controller pause while
           the stamped velocity/sensor TTLs independently enforce zero output. -->
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker" server_timeout="500" error_code_id="{follow_path_error_code}"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
