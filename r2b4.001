#!/usr/bin/env bash
# R2B4 user launcher: thin wrapper over the existing native V3 runtime/CLI.
# No second robot-control, capture, replay or Test Hub authority is introduced.

SRC="${BASH_SOURCE[0]}"
ROOT="$(cd "$(dirname "$SRC")" && pwd)"

# Optional global Ctrl+C panic hook:
#   source /home/alba/project_r2b4/r2b4
if [[ "$SRC" != "$0" ]]; then
    export R2B4_CTRL_C_HOOK=1
    _r2b4_panic_hook() {
        printf '\nR2B4: Ctrl+C -> STOP + runtime shutdown\n' >&2
        "$ROOT/r2b4" panic --quiet >/dev/null 2>&1 || true
    }
    trap '_r2b4_panic_hook' INT
    return 0
fi

set -u
cd "$ROOT" || exit 1

RUNTIME_DIR="$ROOT/runtime"
CAPTURE_DIR="$RUNTIME_DIR/captures"
TEST_HUB_DIR="$RUNTIME_DIR/test_hub"
RUNTIME_LOG="/tmp/r2b4-runtime-current.log"
COMMAND_LOG="/tmp/r2b4-command-current.log"
TEST_HUB_LOG="/tmp/r2b4-testhub-current.log"

RUNTIME_PID_FILE="$RUNTIME_DIR/.r2b4_runtime_pid"
COMMAND_PID_FILE="$RUNTIME_DIR/.r2b4_command_pid"
CAPTURE_PATH_FILE="$RUNTIME_DIR/.r2b4_capture_path"
CAPTURE_USED_FILE="$RUNTIME_DIR/.r2b4_capture_triggered"
CAPTURE_PROFILE_FILE="$RUNTIME_DIR/.r2b4_capture_profile"
MOVEMENT_CAPTURE_FILE="$RUNTIME_DIR/.r2b4_movement_capture"

mkdir -p "$RUNTIME_DIR" "$CAPTURE_DIR" "$TEST_HUB_DIR"

usage() {
cat <<'EOF_USAGE'
Usage:
  r2b4 runtime start [ring|full]
  r2b4 runtime stop
  r2b4 runtime status
  r2b4 runtime diag

  r2b4 capture start
  r2b4 capture stop
  r2b4 capture status

  r2b4 forward start [speed_mps] [ring|full|nocapture]
  r2b4 mozog start <left_mps> <right_mps> [ring|full|nocapture]
  r2b4 roomcruise start [ring|full|nocapture]

Short aliases:
  r2b4 room [ring|full|nocapture]
  r2b4 forward [speed_mps] [ring|full|nocapture]
  r2b4 move <left_mps> <right_mps> [ring|full|nocapture]
  r2b4 status
  r2b4 diag
  r2b4 stop
  r2b4 shutdown
  r2b4 last

Defaults:
  forward speed: 0.15 m/s
  mozog/move wheel speeds: signed m/s, each within [-0.50, 0.50]
  capture profile: ring

Capture profiles:
  ring       native bounded triggered ring (default; STOP/FAULT event evidence)
  full       native append_only capture for the whole runtime session
  nocapture  skips movement-triggered capture; native FAULT evidence remains available

Motion commands auto-start the runtime when it is not running. If the requested
capture profile requires another native capture mode, the launcher performs the
existing safe STOP -> runtime shutdown -> fresh runtime start transition.

After an actual runtime shutdown, a finalized complete capture that has no
existing Test Hub evidence is validated automatically with:
  python3 -m v3.test_hub validate <capture> --output-dir <dir>
The Test Hub never runs while the live runtime is running.

"shutdown" performs robot STOP, runtime shutdown, capture finalization and then
Test Hub validation. "last" shows the latest capture/Test Hub summary.

Global Ctrl+C panic at the shell prompt:
  source /home/alba/project_r2b4/r2b4
EOF_USAGE
}

_pid_has_arg() {
    local pid="$1" wanted="$2" cwd arg
    local argv=()
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
    [[ "$cwd" == "$ROOT" ]] || return 1
    mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null || return 1
    for arg in "${argv[@]}"; do
        [[ "$arg" == "$wanted" ]] && return 0
    done
    return 1
}

_find_pid() {
    local wanted="$1" proc pid
    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        _pid_has_arg "$pid" "$wanted" && { echo "$pid"; return 0; }
    done
    return 1
}

_get_pid() {
    local file="$1" wanted="$2" pid=""
    if [[ -r "$file" ]]; then
        pid="$(cat "$file" 2>/dev/null || true)"
        if _pid_has_arg "$pid" "$wanted"; then
            echo "$pid"
            return 0
        fi
        rm -f "$file"
    fi
    pid="$(_find_pid "$wanted" 2>/dev/null || true)"
    if [[ -n "$pid" ]]; then
        echo "$pid" >"$file"
        chmod 600 "$file" 2>/dev/null || true
        echo "$pid"
        return 0
    fi
    return 1
}

_runtime_pid() { _get_pid "$RUNTIME_PID_FILE" "v3_process_runtime.py"; }
_command_pid() { _get_pid "$COMMAND_PID_FILE" "v3.control_cli"; }

_wait_gone() {
    local pid="$1" i
    for i in {1..100}; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 0.05
    done
    return 1
}

_stop_heartbeat() {
    local pid=""
    pid="$(_command_pid 2>/dev/null || true)"
    [[ -z "$pid" ]] && return 0
    kill -TERM "$pid" 2>/dev/null || true
    if ! _wait_gone "$pid"; then
        echo "ERROR: command heartbeat did not stop (PID $pid)." >&2
        return 1
    fi
    rm -f "$COMMAND_PID_FILE"
}

_publish_stop() {
    python3 -m v3.control_cli stop \
        --command-id "launcher-stop-$(date +%s%N)-$$" >/dev/null 2>&1
}

_current_capture_profile() {
    [[ -r "$CAPTURE_PROFILE_FILE" ]] && cat "$CAPTURE_PROFILE_FILE" || echo "ring"
}

_current_capture() {
    [[ -r "$CAPTURE_PATH_FILE" ]] && cat "$CAPTURE_PATH_FILE"
}

_capture_used() {
    [[ -e "$CAPTURE_USED_FILE" ]] && return 0
    local p=""
    p="$(_current_capture)"
    [[ -n "$p" && -f "$p" ]]
}

_trigger_current_capture() {
    local origin="$1" pid="" path="" profile=""
    profile="$(_current_capture_profile)"
    if [[ "$profile" == "full" ]]; then
        # append_only is already continuously recording; no SIGUSR1 event trigger needed.
        return 0
    fi

    pid="$(_runtime_pid 2>/dev/null || true)"
    [[ -n "$pid" ]] || { echo "ERROR: runtime is not running." >&2; return 1; }
    path="$(_current_capture)"
    [[ -n "$path" ]] || { echo "ERROR: no launcher-managed capture path." >&2; return 1; }
    _capture_used && return 0

    kill -USR1 "$pid" 2>/dev/null || { echo "ERROR: capture trigger failed." >&2; return 1; }
    printf 'origin=%s\ntriggered_at_ns=%s\n' "$origin" "$(date +%s%N)" >"$CAPTURE_USED_FILE"
    chmod 600 "$CAPTURE_USED_FILE" 2>/dev/null || true
    echo "capture: TRIGGERED ($origin)"
    echo "capture file: ${path#"$ROOT"/}"
}

_trigger_movement_capture_if_needed() {
    [[ -e "$MOVEMENT_CAPTURE_FILE" ]] || return 0
    [[ "$(_current_capture_profile)" == "full" ]] && return 0
    _capture_used && return 0
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 0
    _trigger_current_capture "movement-stop"
}

_robot_stop() {
    _trigger_movement_capture_if_needed || true
    _stop_heartbeat || return 1
    _publish_stop || true
    rm -f "$MOVEMENT_CAPTURE_FILE"
}

_runtime_kill() {
    local pid=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    [[ -z "$pid" ]] && return 0
    kill -TERM "$pid" 2>/dev/null || true
}

_panic() {
    _robot_stop || true
    _runtime_kill
}

trap '_panic; exit 130' INT

_status_json() {
    python3 -m v3.control_cli status 2>/dev/null
}

_status_ready() {
    local s=""
    s="$(_status_json)" || return 1
    [[ "$s" == *'"state": "RUNNING"'* && "$s" == *'"ready_for_active": true'* ]]
}

_tick_from_json() {
    local s="$1"
    if [[ "$s" =~ \"tick_id\":\ ([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "-1"
    fi
}

_status_is_fault() {
    local s="$1"
    [[ "$s" != *'"state": "RUNNING"'* ]] && return 0
    [[ "$s" == *'"safety_decision": "FAULT"'* ]] && return 0
    [[ "$s" != *'"fault_layer": null'* ]] && return 0
    return 1
}

_status_has_real_allow() {
    local s="$1"
    [[ "$s" == *'"state": "RUNNING"'* ]] || return 1
    [[ "$s" == *'"safety_decision": "ALLOW"'* ]] || return 1
    [[ "$s" == *'"enabled": true'* ]] || return 1
    STATUS_JSON="$s" python3 -c '
import json, os, sys
d=json.loads(os.environ["STATUS_JSON"])
l=d.get("left_output"); r=d.get("right_output")
ok=isinstance(l,(int,float)) and isinstance(r,(int,float)) and (abs(float(l))>1e-9 or abs(float(r))>1e-9)
sys.exit(0 if ok else 1)
'
}

_show_status() {
    local s="" pid="" profile=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    s="$(_status_json)" || true
    profile="$(_current_capture_profile)"

    if [[ -z "$s" ]]; then
        [[ -n "$pid" ]] && echo "runtime: RUNNING (status unavailable/booting)" || echo "runtime: STOPPED"
        echo "capture: $profile"
        return
    fi

    STATUS_JSON="$s" RUNTIME_PID="$pid" CAPTURE_PROFILE="$profile" python3 - <<'PY'
import json, os
d=json.loads(os.environ["STATUS_JSON"])
state=d.get("state","UNKNOWN")
print(f"runtime: {state}")
if os.environ.get("RUNTIME_PID"):
    print(f"pid:     {os.environ['RUNTIME_PID']}")
print(f"capture: {os.environ.get('CAPTURE_PROFILE','ring')}")
if state=="RUNNING":
    ready=d.get("ready_for_active")
    print(f"ready:   {'YES' if ready is True else 'NO' if ready is False else '-'}")
    print(f"tick:    {d.get('tick_id','-')}")
    print(f"safety:  {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
else:
    r=d.get("report") or {}
    print(f"reason:  {r.get('final_reason') or r.get('exit_reason') or d.get('error') or '-'}")
    if r.get("fault_layer"):
        print(f"fault:   {r['fault_layer']}")
PY
}

_show_diag() {
    local s="" pid="" profile=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    s="$(_status_json)" || true
    profile="$(_current_capture_profile)"

    if [[ -z "$s" ]]; then
        [[ -n "$pid" ]] && echo "R2B4 runtime: RUNNING (status unavailable/booting)" || echo "R2B4 runtime: STOPPED"
        echo "Capture:      $profile"
        [[ -s "$RUNTIME_LOG" ]] && { echo; echo "Last runtime log:"; tail -n 20 "$RUNTIME_LOG"; }
        return
    fi

    STATUS_JSON="$s" RUNTIME_PID="$pid" CAPTURE_PROFILE="$profile" python3 - <<'PY'
import json, math, os
d=json.loads(os.environ["STATUS_JSON"])
state=d.get("state","UNKNOWN")
print(f"R2B4 runtime: {state}")
if os.environ.get("RUNTIME_PID"):
    print(f"PID:          {os.environ['RUNTIME_PID']}")
print(f"Capture:      {os.environ.get('CAPTURE_PROFILE','ring')}")
if state=="RUNNING":
    ready=d.get("ready_for_active")
    print(f"Ready:        {'YES' if ready is True else 'NO' if ready is False else '-'}")
    print(f"Tick:         {d.get('tick_id','-')}")
    print(f"Fault layer:  {d.get('fault_layer') or '-'}")
    print(f"Safety:       {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
    print(f"Motors:       {d.get('left_output','-')} / {d.get('right_output','-')}")
    for h in d.get("source_health") or []:
        reason=f" ({h.get('reason')})" if h.get("reason") else ""
        print(f"{h.get('device_id','?')}: {h.get('state','?')}{reason}")
    e=d.get("estimate")
    if isinstance(e,dict):
        yaw=e.get("yaw_rad")
        yaw=math.degrees(yaw) if isinstance(yaw,(int,float)) else None
        print(f"x:            {e.get('x_m','-')} m")
        print(f"y:            {e.get('y_m','-')} m")
        print(f"yaw:          {yaw:.2f} deg" if yaw is not None else "yaw:          -")
        print(f"v:            {e.get('v_mps','-')} m/s")
        print(f"omega:        {e.get('omega_rad_s','-')} rad/s")
else:
    r=d.get("report") or {}
    print(f"Exit reason:  {r.get('exit_reason','-')}")
    print(f"Lifecycle:    {r.get('final_lifecycle','-')}")
    print(f"Safety:       {r.get('final_safety_decision','-')} / {r.get('final_reason','-')}")
    print(f"Fault layer:  {r.get('fault_layer') or '-'}")
    print(f"Termination:  {r.get('termination_class','-')}")
    if d.get("error"):
        print(f"Error:        {d.get('error_type','ERROR')}: {d.get('error')}")
PY
    [[ "$s" != *'"state": "RUNNING"'* && -s "$RUNTIME_LOG" ]] && {
        echo
        echo "Last runtime log:"
        tail -n 20 "$RUNTIME_LOG"
    }
}

_new_capture_path() {
    echo "$CAPTURE_DIR/v3_$(date '+%Y%m%d_%H%M%S')_$$_capture.json"
}

_capture_is_complete() {
    local path="$1"
    [[ -f "$path" ]] || return 1
    CAPTURE_FILE="$path" python3 - <<'PY'
import json, os
from pathlib import Path
try:
    d=json.loads(Path(os.environ["CAPTURE_FILE"]).read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)
i=d.get("capture_integrity")
complete=isinstance(i, dict) and i.get("complete") is True
terminal=d.get("status") in {"PASS","FAIL","FAULT"}
raise SystemExit(0 if complete and terminal else 1)
PY
}

_capture_has_testhub_evidence() {
    local path="$1"
    CAPTURE_FILE="$path" TEST_HUB_DIR="$TEST_HUB_DIR" python3 - <<'PY'
import json, os, sys
from pathlib import Path
capture=Path(os.environ["CAPTURE_FILE"]).resolve()
root=Path(os.environ["TEST_HUB_DIR"])
for index in root.glob("*/evidence_index.json"):
    try:
        d=json.loads(index.read_text(encoding="utf-8"))
        p=((d.get("capture") or {}).get("path"))
        if p and Path(p).resolve() == capture:
            print(index)
            raise SystemExit(0)
    except (OSError, ValueError, json.JSONDecodeError):
        continue
raise SystemExit(1)
PY
}

_wait_capture_finalized() {
    local path="$1" i
    [[ -n "$path" ]] || return 1
    for i in {1..100}; do
        [[ -f "$path" ]] && return 0
        sleep 0.05
    done
    return 1
}

_run_testhub_for_capture() {
    local path="$1" existing="" base="" out="" result=""
    [[ -n "$path" && -f "$path" ]] || return 0
    [[ -z "$(_runtime_pid 2>/dev/null || true)" ]] || {
        echo "testhub: SKIPPED (runtime still running)"
        return 0
    }
    if ! _capture_is_complete "$path"; then
        echo "testhub: SKIPPED (capture not finalized/complete)"
        return 0
    fi
    existing="$(_capture_has_testhub_evidence "$path" 2>/dev/null || true)"
    if [[ -n "$existing" ]]; then
        echo "testhub: already validated -> ${existing#"$ROOT"/}"
        return 0
    fi

    base="$(basename "$path" .json)"
    out="$TEST_HUB_DIR/auto_${base}"
    if [[ -e "$out" ]]; then
        out="${out}_retry_$(date '+%Y%m%d_%H%M%S')"
    fi

    : >"$TEST_HUB_LOG"
    echo "testhub: RUN -> ${path#"$ROOT"/}"
    if python3 -m v3.test_hub validate "$path" --output-dir "$out" --project-root "$ROOT" \
        >"$TEST_HUB_LOG" 2>&1; then
        :
    fi

    result="$(cat "$TEST_HUB_LOG" 2>/dev/null || true)"
    if [[ -n "$result" ]]; then
        TESTHUB_JSON="$result" python3 - <<'PY' 2>/dev/null || { cat "$TEST_HUB_LOG"; return 0; }
import json, os
try:
    d=json.loads(os.environ["TESTHUB_JSON"])
except json.JSONDecodeError:
    raise SystemExit(1)
print(f"testhub: {d.get('status','ERROR')}")
print(f"capture: {d.get('capture_status','-')}")
print(f"replay:  {d.get('replay_status','-')}")
inc=d.get("first_live_incident")
if isinstance(inc, dict):
    reason=inc.get("reason") or inc.get("safety_reason") or inc.get("type")
    layer=inc.get("layer") or inc.get("fault_layer")
    if reason or layer:
        print(f"incident:{' '+str(layer) if layer else ''}{' / '+str(reason) if reason else ''}")
print(f"evidence: {d.get('output_dir','-')}")
PY
    else
        echo "testhub: ERROR (no output)"
    fi
    return 0
}

_run_testhub_after_shutdown() {
    local path="$1"
    [[ -n "$path" ]] || return 0
    _wait_capture_finalized "$path" || {
        # A ring slot that was never triggered legitimately produces no file.
        [[ -f "$path" ]] || { echo "testhub: no finalized capture"; return 0; }
    }
    _run_testhub_for_capture "$path"
}

_wait_ready() {
    local i
    for i in {1..160}; do
        [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 1
        _status_ready && return 0
        sleep 0.05
    done
    return 1
}

_wait_fresh_ready() {
    local pid="$1" baseline="$2" s="" i
    for i in {1..160}; do
        _pid_has_arg "$pid" "v3_process_runtime.py" || return 1
        s="$(_status_json)" || { sleep 0.05; continue; }
        if [[ "$s" != "$baseline" && "$s" == *'"state": "RUNNING"'* && "$s" == *'"ready_for_active": true'* ]]; then
            return 0
        fi
        sleep 0.05
    done
    return 1
}

_runtime_start() {
    local profile="${1:-ring}" force="${2:-no}" old="" fresh="" status_baseline="" mode="triggered"
    [[ "$profile" == "ring" || "$profile" == "full" ]] || {
        echo "ERROR: runtime capture profile must be ring or full." >&2
        return 2
    }
    [[ "$profile" == "full" ]] && mode="append_only"

    old="$(_runtime_pid 2>/dev/null || true)"
    if [[ -n "$old" ]]; then
        local old_profile current_path
        old_profile="$(_current_capture_profile)"
        if [[ "$old_profile" == "$profile" && "$force" != "yes" ]] && _wait_ready; then
            echo "runtime: already RUNNING / READY (capture=$profile)"
            return 0
        fi
        current_path="$(_current_capture)"
        echo "runtime: existing instance -> safe restart"
        _robot_stop || true
        kill -TERM "$old" 2>/dev/null || true
        if ! _wait_gone "$old"; then
            echo "ERROR: old runtime still running (PID $old). New runtime not started." >&2
            return 1
        fi
        rm -f "$RUNTIME_PID_FILE"
        echo "runtime: STOPPED"
        _run_testhub_after_shutdown "$current_path" || true
        echo "runtime: waiting 5 s"
        sleep 5
    else
        _stop_heartbeat || true
    fi

    status_baseline="$(_status_json 2>/dev/null || true)"
    fresh="$(_new_capture_path)"
    echo "$fresh" >"$CAPTURE_PATH_FILE"
    echo "$profile" >"$CAPTURE_PROFILE_FILE"
    chmod 600 "$CAPTURE_PATH_FILE" "$CAPTURE_PROFILE_FILE" 2>/dev/null || true
    rm -f "$CAPTURE_USED_FILE" "$MOVEMENT_CAPTURE_FILE"

    : >"$RUNTIME_LOG"
    nohup python3 v3_process_runtime.py \
        --approval native-resident-v3 \
        --capture-path "${fresh#"$ROOT"/}" \
        --capture-mode "$mode" \
        </dev/null >"$RUNTIME_LOG" 2>&1 &
    local pid=$!
    echo "$pid" >"$RUNTIME_PID_FILE"
    chmod 600 "$RUNTIME_PID_FILE" 2>/dev/null || true

    sleep 0.20
    if ! _pid_has_arg "$pid" "v3_process_runtime.py"; then
        rm -f "$RUNTIME_PID_FILE"
        echo "ERROR: runtime failed to start." >&2
        [[ -s "$RUNTIME_LOG" ]] && tail -n 30 "$RUNTIME_LOG" >&2
        return 1
    fi
    if ! _wait_fresh_ready "$pid" "$status_baseline"; then
        echo "ERROR: runtime did not publish a fresh ready status." >&2
        _show_diag >&2
        return 1
    fi

    echo "runtime: STARTED (PID $pid)"
    if [[ "$profile" == "full" ]]; then
        echo "capture: FULL / append_only"
    else
        echo "capture: ARMED (bounded ring)"
    fi
    echo "capture file: ${fresh#"$ROOT"/}"
    [[ "${R2B4_CTRL_C_HOOK:-0}" != "1" ]] && \
        echo "note: global Ctrl+C panic hook inactive; source $ROOT/r2b4"
}

_ensure_runtime() {
    local requested="$1" desired="$requested" pid="" current=""
    [[ "$requested" == "nocapture" ]] && desired="ring"
    pid="$(_runtime_pid 2>/dev/null || true)"
    if [[ -z "$pid" ]]; then
        echo "runtime: not running -> auto start"
        _runtime_start "$desired" || return 1
        return 0
    fi
    current="$(_current_capture_profile)"
    if [[ "$current" != "$desired" ]]; then
        echo "runtime: capture profile $current -> $desired"
        _runtime_start "$desired" || return 1
    fi
    _wait_ready || { echo "ERROR: runtime is not ready for ACTIVE." >&2; _show_diag >&2; return 1; }
}

_runtime_stop() {
    local pid="" path=""
    path="$(_current_capture)"
    _robot_stop || true
    pid="$(_runtime_pid 2>/dev/null || true)"
    if [[ -z "$pid" ]]; then
        echo "runtime: already STOPPED"
        _run_testhub_after_shutdown "$path" || true
        return 0
    fi
    kill -TERM "$pid" 2>/dev/null || true
    if ! _wait_gone "$pid"; then
        echo "ERROR: runtime did not stop (PID $pid). Test Hub not started." >&2
        return 1
    fi
    rm -f "$RUNTIME_PID_FILE"
    echo "runtime: STOPPED"
    _run_testhub_after_shutdown "$path" || true
}

_shutdown() {
    _runtime_stop
}

_ensure_fresh_capture_slot() {
    [[ "$(_current_capture_profile)" == "full" ]] && return 0
    if ! _capture_used; then
        return 0
    fi
    echo "capture: previous ring slot used -> safe runtime re-arm"
    _runtime_start ring yes || return 1
    _wait_ready || {
        echo "ERROR: restarted runtime not ready." >&2
        _show_diag >&2
        return 1
    }
}

_trigger_capture() {
    local origin="$1"
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || {
        echo "ERROR: runtime is not running." >&2
        return 1
    }
    if [[ "$(_current_capture_profile)" == "full" ]]; then
        echo "capture: FULL is already recording continuously"
        return 0
    fi
    _ensure_fresh_capture_slot || return 1
    _trigger_current_capture "$origin"
}

_capture_status() {
    local path="" profile=""
    path="$(_current_capture)"
    profile="$(_current_capture_profile)"
    [[ -n "$path" ]] || { echo "capture: NOT ARMED"; return; }

    if [[ -f "$path" ]]; then
        CAPTURE_FILE="$path" CAPTURE_PROFILE="$profile" python3 - <<'PY'
import json, os
from pathlib import Path
p=Path(os.environ["CAPTURE_FILE"])
d=json.loads(p.read_text(encoding="utf-8"))
print("capture: FINALIZED")
print(f"profile: {os.environ.get('CAPTURE_PROFILE','ring')}")
print(f"file:    {p}")
print(f"status:  {d.get('status','-')}")
print(f"ticks:   {d.get('tick_count','-')}")
w=d.get("capture_window") or {}
i=d.get("capture_integrity") or {}
print(f"trigger: {w.get('trigger_reason','-')}")
if i:
    print(f"complete:{' YES' if i.get('complete') is True else ' NO'}")
PY
    elif [[ "$profile" == "full" && -n "$(_runtime_pid 2>/dev/null || true)" ]]; then
        echo "capture: FULL / recording"
        echo "file:    ${path#"$ROOT"/}"
    elif [[ -e "$CAPTURE_USED_FILE" ]]; then
        echo "capture: TRIGGERED / finalizing"
        echo "file:    ${path#"$ROOT"/}"
    elif [[ -e "$MOVEMENT_CAPTURE_FILE" ]]; then
        echo "capture: ARMED for movement (will save on STOP/FAULT)"
        echo "file:    ${path#"$ROOT"/}"
    else
        echo "capture: ARMED"
        echo "file:    ${path#"$ROOT"/}"
    fi
}

_capture_stop() {
    local path="" profile="" i
    path="$(_current_capture)"
    profile="$(_current_capture_profile)"
    [[ -n "$path" ]] || { echo "capture: NOT ARMED"; return 1; }

    if [[ "$profile" == "full" ]]; then
        echo "capture: FULL finalizes on runtime stop/shutdown"
        _capture_status
        return 0
    fi
    if [[ -e "$MOVEMENT_CAPTURE_FILE" && ! -e "$CAPTURE_USED_FILE" && ! -f "$path" ]]; then
        _trigger_current_capture "capture-stop" || return 1
    fi
    if [[ ! -e "$CAPTURE_USED_FILE" && ! -f "$path" ]]; then
        echo "capture: no triggered capture"
        return 0
    fi
    for i in {1..70}; do
        [[ -f "$path" ]] && break
        sleep 0.05
    done
    if [[ -f "$path" ]]; then
        _capture_status
    else
        echo "capture: still finalizing"
        echo "file:    ${path#"$ROOT"/}"
    fi
}

_valid_speed() {
    python3 - "$1" <<'PY'
import math, sys
try: v=float(sys.argv[1])
except ValueError: raise SystemExit(1)
raise SystemExit(0 if math.isfinite(v) and 0.0 < v <= 0.50 else 1)
PY
}

_failure_report() {
    local label="$1" saved="${2:-}" s="$saved"
    echo "ERROR: $label did not reach motor ALLOW." >&2
    [[ -z "$s" ]] && s="$(_status_json)" || true
    if [[ -n "$s" ]]; then
        echo >&2
        STATUS_JSON="$s" python3 - <<'PY' >&2
import json, os
d=json.loads(os.environ["STATUS_JSON"])
print(f"state:       {d.get('state','-')}")
print(f"tick:        {d.get('tick_id','-')}")
print(f"fault layer: {d.get('fault_layer') or '-'}")
print(f"safety:      {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
print(f"motors:      {d.get('left_output','-')} / {d.get('right_output','-')}")
r=d.get("report") or {}
if r:
    print(f"final:       {r.get('final_safety_decision','-')} / {r.get('final_reason','-')}")
    print(f"termination: {r.get('termination_class','-')}")
PY
    fi
    [[ -s "$COMMAND_LOG" ]] && { echo >&2; echo "Command log:" >&2; tail -n 20 "$COMMAND_LOG" >&2; }
    [[ -s "$RUNTIME_LOG" ]] && { echo >&2; echo "Runtime log:" >&2; tail -n 20 "$RUNTIME_LOG" >&2; }
}

_wait_allow() {
    local cpid="$1" baseline="$2" label="$3" s="" tick i
    for i in {1..50}; do
        if ! _pid_has_arg "$cpid" "v3.control_cli"; then
            _failure_report "$label" "$s"
            return 1
        fi
        if [[ -z "$(_runtime_pid 2>/dev/null || true)" ]]; then
            _stop_heartbeat || true
            _failure_report "$label"
            return 1
        fi
        s="$(_status_json)" || { sleep 0.05; continue; }
        tick="$(_tick_from_json "$s")"
        if (( tick > baseline )); then
            if _status_is_fault "$s"; then
                local bad="$s"
                _trigger_movement_capture_if_needed || true
                _stop_heartbeat || true
                _publish_stop || true
                rm -f "$MOVEMENT_CAPTURE_FILE"
                _failure_report "$label" "$bad"
                return 1
            fi
            _status_has_real_allow "$s" && return 0
        fi
        sleep 0.05
    done

    local last="$s"
    _trigger_movement_capture_if_needed || true
    _stop_heartbeat || true
    _publish_stop || true
    rm -f "$MOVEMENT_CAPTURE_FILE"
    _failure_report "$label" "$last"
    return 1
}

_start_motion() {
    local label="$1" profile="$2"
    shift 2
    local s="" baseline="-1" cpid

    _ensure_runtime "$profile" || return 1
    _status_ready || { echo "ERROR: runtime is not ready for ACTIVE." >&2; _show_diag >&2; return 1; }

    _robot_stop || return 1
    for _ in {1..20}; do _status_ready && break; sleep 0.05; done
    _status_ready || { echo "ERROR: runtime did not return to ready IDLE." >&2; _show_diag >&2; return 1; }

    if [[ "$profile" == "ring" ]]; then
        _ensure_fresh_capture_slot || return 1
        _wait_ready || { echo "ERROR: runtime not ready after capture re-arm." >&2; return 1; }
        echo "movement" >"$MOVEMENT_CAPTURE_FILE"
        chmod 600 "$MOVEMENT_CAPTURE_FILE" 2>/dev/null || true
    else
        rm -f "$MOVEMENT_CAPTURE_FILE"
    fi

    s="$(_status_json)" || true
    [[ -n "$s" ]] && baseline="$(_tick_from_json "$s")"

    : >"$COMMAND_LOG"
    nohup "$@" </dev/null >"$COMMAND_LOG" 2>&1 &
    cpid=$!
    echo "$cpid" >"$COMMAND_PID_FILE"
    chmod 600 "$COMMAND_PID_FILE" 2>/dev/null || true

    _wait_allow "$cpid" "$baseline" "$label" || return 1

    echo "$label: STARTED"
    echo "motor: ALLOW confirmed"
    case "$profile" in
        ring)
            local p="$(_current_capture)"
            echo "capture: RING / armed for STOP/FAULT -> ${p#"$ROOT"/}"
            ;;
        full)
            echo "capture: FULL / append_only recording"
            ;;
        nocapture)
            echo "capture: movement capture skipped (FAULT evidence remains native)"
            ;;
    esac
}

_forward() {
    local speed="0.15" speed_set="no" profile="ring" a
    shift 2
    for a in "$@"; do
        case "$a" in
            ring|full|nocapture) profile="$a" ;;
            *)
                if [[ "$speed_set" == "no" ]]; then speed="$a"; speed_set="yes"
                else echo "ERROR: invalid forward arguments." >&2; return 2
                fi
                ;;
        esac
    done
    _valid_speed "$speed" || { echo "ERROR: speed must be >0 and <=0.50 m/s." >&2; return 1; }
    _start_motion "forward $speed m/s" "$profile" \
        python3 -m v3.control_cli teleop \
        --command-id "launcher-forward-$(date +%s%N)-$$" \
        --v-mps "$speed" --omega-rad-s 0 \
        --max-v-mps "$speed" --max-omega-rad-s 0.60
}

_wheel_targets_to_twist() {
    python3 - "$ROOT/conf/fizika.json" "$1" "$2" <<'PY'
import json, math, sys
from pathlib import Path
physics_path=Path(sys.argv[1])
try:
    left_mps=float(sys.argv[2]); right_mps=float(sys.argv[3])
except ValueError:
    print("ERROR: left_mps and right_mps must be numeric.", file=sys.stderr); raise SystemExit(1)
if not math.isfinite(left_mps) or not math.isfinite(right_mps):
    print("ERROR: wheel speeds must be finite.", file=sys.stderr); raise SystemExit(1)
if abs(left_mps)>0.50 or abs(right_mps)>0.50:
    print("ERROR: each wheel speed must be within [-0.50, 0.50] m/s.", file=sys.stderr); raise SystemExit(1)
if abs(left_mps)<=1e-12 and abs(right_mps)<=1e-12:
    print("ERROR: both wheel targets are zero; use ./r2b4 stop.", file=sys.stderr); raise SystemExit(1)
try:
    physics=json.loads(physics_path.read_text(encoding="utf-8")); track=float(physics["nyomtav_szelesseg_m"])
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
    print(f"ERROR: cannot read valid track width from {physics_path}: {exc}", file=sys.stderr); raise SystemExit(1)
if not math.isfinite(track) or track<=0:
    print("ERROR: nyomtav_szelesseg_m must be finite and positive.", file=sys.stderr); raise SystemExit(1)
v=0.5*(left_mps+right_mps)
omega=(right_mps-left_mps)/track
if abs(v)>0.50+1e-12:
    print(f"ERROR: wheel pair requires v={v:.6f} m/s above the resident 0.50 m/s limit.", file=sys.stderr); raise SystemExit(1)
if abs(omega)>1.20+1e-12:
    print(f"ERROR: wheel pair requires omega={omega:.6f} rad/s above the resident 1.20 rad/s limit.", file=sys.stderr); raise SystemExit(1)
print(f"{v:.12g} {omega:.12g} {max(abs(v),1e-6):.12g} {max(abs(omega),1e-6):.12g} {track:.12g}")
PY
}

_mozog() {
    local profile="ring" left right converted v omega max_v max_omega track
    shift 2
    [[ $# -ge 2 && $# -le 3 ]] || {
        echo "ERROR: usage: ./r2b4 mozog start <left_mps> <right_mps> [ring|full|nocapture]" >&2
        return 2
    }
    left="$1"; right="$2"
    if [[ $# -eq 3 ]]; then
        case "$3" in ring|full|nocapture) profile="$3" ;; *) echo "ERROR: unknown option: $3" >&2; return 2 ;; esac
    fi
    converted="$(_wheel_targets_to_twist "$left" "$right")" || return 1
    read -r v omega max_v max_omega track <<<"$converted"
    echo "mozog wheel target: left=$left m/s, right=$right m/s"
    echo "canonical target: v=$v m/s, omega=$omega rad/s (track=$track m)"
    _start_motion "mozog L=$left R=$right m/s" "$profile" \
        python3 -m v3.control_cli teleop \
        --command-id "launcher-mozog-$(date +%s%N)-$$" \
        --v-mps "$v" --omega-rad-s "$omega" \
        --max-v-mps "$max_v" --max-omega-rad-s "$max_omega"
}

_roomcruise() {
    local profile="ring"
    shift 2
    [[ $# -le 1 ]] || { echo "ERROR: roomcruise accepts only optional ring|full|nocapture." >&2; return 2; }
    if [[ $# -eq 1 ]]; then
        case "$1" in ring|full|nocapture) profile="$1" ;; *) echo "ERROR: unknown option: $1" >&2; return 2 ;; esac
    fi
    _start_motion "roomcruise" "$profile" \
        python3 -m v3.control_cli explore \
        --command-id "launcher-roomcruise-$(date +%s%N)-$$"
}

_show_last() {
    CAPTURE_DIR="$CAPTURE_DIR" TEST_HUB_DIR="$TEST_HUB_DIR" python3 - <<'PY'
import json
from pathlib import Path
import os
captures=sorted(Path(os.environ["CAPTURE_DIR"]).glob("v3_*_capture.json"), key=lambda p:p.stat().st_mtime, reverse=True)
if not captures:
    print("last: no finalized capture")
    raise SystemExit(0)
p=captures[0]
try: d=json.loads(p.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"last capture: {p}"); print(f"ERROR: {exc}"); raise SystemExit(0)
print(f"capture: {p}")
print(f"status:  {d.get('status','-')}")
print(f"ticks:   {d.get('tick_count','-')}")
w=d.get("capture_window") or {}; integ=d.get("capture_integrity") or {}
if w: print(f"trigger: {w.get('trigger_reason','-')}")
if integ: print(f"complete:{' YES' if integ.get('complete') is True else ' NO'}")
found=None
for idx in Path(os.environ["TEST_HUB_DIR"]).glob("*/evidence_index.json"):
    try:
        x=json.loads(idx.read_text(encoding="utf-8")); cp=((x.get("capture") or {}).get("path"))
        if cp and Path(cp).resolve()==p.resolve(): found=(idx,x); break
    except Exception: pass
if not found:
    print("testhub: NOT RUN")
    raise SystemExit(0)
idx,x=found
print(f"testhub: {x.get('status','-')}")
rep=idx.parent/"replay_result.json"
diag=idx.parent/"diagnosis.json"
if rep.is_file():
    try:
        r=json.loads(rep.read_text(encoding="utf-8")); print(f"replay:  {r.get('status','-')}")
    except Exception: pass
if diag.is_file():
    try:
        g=json.loads(diag.read_text(encoding="utf-8")); inc=g.get("first_live_incident")
        if isinstance(inc,dict):
            layer=inc.get("layer") or inc.get("fault_layer"); reason=inc.get("reason") or inc.get("safety_reason") or inc.get("type")
            if layer or reason: print(f"incident:{' '+str(layer) if layer else ''}{' / '+str(reason) if reason else ''}")
    except Exception: pass
print(f"evidence:{idx.parent}")
PY
}

main() {
    case "${1:-} ${2:-}" in
        "runtime start")
            [[ $# -le 3 ]] || { usage; return 2; }
            _runtime_start "${3:-ring}" yes
            ;;
        "runtime stop")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _runtime_stop
            ;;
        "runtime status")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _show_status
            ;;
        "runtime diag")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _show_diag
            ;;
        "capture start")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _trigger_capture "manual"
            ;;
        "capture stop")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _capture_stop
            ;;
        "capture status")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _capture_status
            ;;
        "forward start") _forward "$@" ;;
        "mozog start") _mozog "$@" ;;
        "roomcruise start") _roomcruise "$@" ;;
        "stop ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _robot_stop
            echo "robot: STOP published"
            ;;
        "shutdown ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _shutdown
            ;;
        "last ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _show_last
            ;;
        "status ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _show_status
            ;;
        "diag ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _show_diag
            ;;
        room\ *)
            shift
            _roomcruise room start "$@"
            ;;
        forward\ *)
            shift
            _forward forward start "$@"
            ;;
        move\ *)
            shift
            _mozog move start "$@"
            ;;
        "panic --quiet") _panic ;;
        "panic ")
            _panic
            echo "robot: STOP + runtime shutdown requested"
            ;;
        "help "|"--help "|"-h ") usage ;;
        *) usage; return 2 ;;
    esac
}

main "$@"
