#!/usr/bin/env bash
# R2B4 user launcher: thin wrapper over the existing native V3 runtime/CLI.
# No second robot-control or capture path is introduced.

SRC="${BASH_SOURCE[0]}"
ROOT="$(cd "$(dirname "$SRC")" && pwd)"

# Optional global Ctrl+C panic hook:
#   source /home/alba/project_r2b4/r2b4
if [[ "$SRC" != "$0" ]]; then
    export R2B4_CTRL_C_HOOK=1
    _r2b4_panic_hook() {
        printf '\nR2B4: Ctrl+C -> STOP + runtime shutdown\n' >&2
        "$ROOT/r2b4" panic --quiet >/dev/null 2>&1 || true
    }
    trap '_r2b4_panic_hook' INT
    return 0
fi

set -u
cd "$ROOT" || exit 1

RUNTIME_DIR="$ROOT/runtime"
CAPTURE_DIR="$RUNTIME_DIR/captures"
STATUS_FILE="$RUNTIME_DIR/v3_status.json"
COMMAND_FILE="$RUNTIME_DIR/v3_command.json"
RUNTIME_LOG="/tmp/r2b4-runtime-current.log"
COMMAND_LOG="/tmp/r2b4-command-current.log"
[[ -r "$RUNTIME_DIR/.r2b4_runtime_log" ]] && read -r RUNTIME_LOG <"$RUNTIME_DIR/.r2b4_runtime_log"
[[ -r "$RUNTIME_DIR/.r2b4_command_log" ]] && read -r COMMAND_LOG <"$RUNTIME_DIR/.r2b4_command_log"

RUNTIME_PID_FILE="$RUNTIME_DIR/.r2b4_runtime_pid"
COMMAND_PID_FILE="$RUNTIME_DIR/.r2b4_command_pid"
CAPTURE_PATH_FILE="$RUNTIME_DIR/.r2b4_capture_path"
CAPTURE_USED_FILE="$RUNTIME_DIR/.r2b4_capture_triggered"
CAPTURE_MODE_FILE="$RUNTIME_DIR/.r2b4_capture_mode"
MOVEMENT_CAPTURE_FILE="$RUNTIME_DIR/.r2b4_movement_capture"

# Launcher selector. It is removed from argv before the legacy command parser
# sees the remaining arguments, so all old command forms keep their meaning.
CAPTURE_MODE="alap"
CAPTURE_MODE_EXPLICIT=0
CLEAN_ARGS=()

mkdir -p "$RUNTIME_DIR" "$CAPTURE_DIR"

usage() {
cat <<'USAGE'
Usage:
  r2b4 runtime start [c alap|full|nincs]
  r2b4 runtime stop
  r2b4 runtime status
  r2b4 runtime diag

  r2b4 capture start [c alap|full|nincs]
  r2b4 capture stop
  r2b4 capture status

  r2b4 forward start [speed_mps] [nocapture] [c alap|full|nincs]
  r2b4 mozog start <left_mps> <right_mps> [nocapture] [c alap|full|nincs]
  r2b4 roomcruise start [nocapture] [c alap|full|nincs]

  r2b4 stop
  r2b4 shutdown
  r2b4 proba [c alap|full|nincs]

Defaults:
  forward speed: 0.15 m/s
  mozog wheel speeds: signed m/s, each within [-0.50, 0.50]
  capture selector: alap

Capture selectors:
  c alap   Native bounded triggered MCAP, explicit 8 s pre + 2 s post.
           This is the default when no selector is supplied.
  c full   Native append-only MCAP from the first capture-observable runtime
           record until native runtime shutdown/finalization.
  c nincs  Capture infrastructure OFF: no --capture-path is passed to the
           native runtime. Intended for clean performance comparison.

Final authority files are written under runtime/captures/*.mcap.
Every finalized launcher-managed capture is analyzed through the integrated
Test Hub entry point in its default mode:
  python3 -m v3.test_hub run <capture.mcap>
The current Test Hub generation keeps canonical V2 diagnosis/replay and adds
the Next agent view. Default evidence is written as *.mcap.evidence_next/.
The Test Hub waits for MCAP finalization/integrity before it starts. If the
selected mode produces no capture, the watcher times out after runtime exit
and still invokes Test Hub once; the missing capture then fails explicitly.

Starting a movement or capture automatically starts the runtime if needed.
"stop" cancels the command producer (including proba) and returns to IDLE.
"shutdown", "runtime stop" and Ctrl+C stop the runtime as well.
Runtime logs use unique paths under /tmp.

"proba" runs ten slow phases in the foreground, with 5 s in IDLE between them:
  forward/reverse: 5 s each, ramping from 0.15 to 0.25 m/s;
  right-forward/right-reverse/left-forward/left-reverse arcs: 5 s each,
    radius decreasing from 2.0 to 0.6 m at 0.15 m/s;
  right/left in-place turns: 90 degrees each;
  right/left turns about the stationary right wheel: 180 degrees each.
Angles use runtime yaw feedback; safety or feedback failure aborts the test.
The final left turn moves the left wheel backwards, with the right target zero.

"capture start" preserves the native one-shot triggered behavior in alap mode.
In full mode capture is already continuous; in nincs mode capture is OFF.
"capture stop" waits for bounded finalization in alap. A full capture is
finalized by runtime stop/shutdown because it covers the complete session.

The native triggered worker is one-shot per runtime. If a new alap-captured
movement needs a fresh slot, the launcher re-arms it by the existing safe
runtime restart (STOP -> 5 s -> new runtime).

"mozog" accepts left/right wheel-speed targets and converts them to the
canonical TELEOP body target using conf/fizika.json track width. Existing
L5-L12 motion, operational and safety constraints remain authoritative.

Legacy "nocapture" is retained unchanged: it skips movement-trigger arming in
alap mode. It does NOT mean capture infrastructure OFF and automatic native
FAULT evidence remains possible. Use "c nincs" for true capture-off operation.

Global Ctrl+C panic at the shell prompt:
  source /home/alba/project_r2b4/r2b4
USAGE
}

_parse_capture_selector() {
    local -a input=("$@")
    local i=0 token mode seen=0
    CLEAN_ARGS=()
    CAPTURE_MODE="alap"
    CAPTURE_MODE_EXPLICIT=0

    while (( i < ${#input[@]} )); do
        token="${input[$i]}"
        if [[ "$token" == "c" ]]; then
            (( i + 1 < ${#input[@]} )) || {
                echo "ERROR: 'c' requires one of: alap, full, nincs." >&2
                return 2
            }
            (( seen == 0 )) || {
                echo "ERROR: capture selector may be specified only once." >&2
                return 2
            }
            mode="${input[$((i + 1))]}"
            case "$mode" in
                alap|full|nincs) ;;
                *)
                    echo "ERROR: invalid capture mode '$mode'; use alap, full or nincs." >&2
                    return 2
                    ;;
            esac
            CAPTURE_MODE="$mode"
            CAPTURE_MODE_EXPLICIT=1
            seen=1
            i=$((i + 2))
            continue
        fi
        CLEAN_ARGS+=("$token")
        i=$((i + 1))
    done
}

_pid_has_arg() {
    local pid="$1" wanted="$2" cwd arg
    local argv=()
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
    [[ "$cwd" == "$ROOT" ]] || return 1
    mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null || return 1
    for arg in "${argv[@]}"; do
        [[ "$arg" == "$wanted" ]] && return 0
    done
    return 1
}

_find_pid() {
    local wanted="$1" proc pid
    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        _pid_has_arg "$pid" "$wanted" && { echo "$pid"; return 0; }
    done
    return 1
}

_get_pid() {
    local file="$1" wanted="$2" pid=""
    if [[ -r "$file" ]]; then
        pid="$(cat "$file" 2>/dev/null || true)"
        if _pid_has_arg "$pid" "$wanted"; then
            echo "$pid"
            return 0
        fi
        rm -f "$file"
    fi
    pid="$(_find_pid "$wanted" 2>/dev/null || true)"
    if [[ -n "$pid" ]]; then
        echo "$pid" >"$file"
        chmod 600 "$file" 2>/dev/null || true
        echo "$pid"
        return 0
    fi
    return 1
}

_runtime_pid() { _get_pid "$RUNTIME_PID_FILE" "v3_process_runtime.py"; }
_command_pid() {
    _get_pid "$COMMAND_PID_FILE" "r2b4-proba" ||
        _get_pid "$COMMAND_PID_FILE" "v3.control_cli"
}

_current_capture_mode() {
    local mode=""
    if [[ -r "$CAPTURE_MODE_FILE" ]]; then
        read -r mode <"$CAPTURE_MODE_FILE" || true
        case "$mode" in alap|full|nincs) echo "$mode"; return 0;; esac
    fi
    # A running pre-selector launcher could only have used triggered capture.
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] && { echo "alap"; return 0; }
    return 1
}

_capture_mode_label() {
    case "$1" in
        alap) echo "ALAP 8+2 triggered" ;;
        full) echo "FULL append-only" ;;
        nincs) echo "OFF" ;;
        *) echo "UNKNOWN" ;;
    esac
}

_wait_gone() {
    local pid="$1" i state
    for i in {1..20}; do
        kill -0 "$pid" 2>/dev/null || return 0
        state="$(cat "/proc/$pid/stat" 2>/dev/null || true)"
        [[ "${state##*) }" == Z* ]] && return 0
        sleep 0.05
    done
    return 1
}

_stop_heartbeat() {
    local pid=""
    while pid="$(_command_pid 2>/dev/null)"; do
        kill -TERM "$pid" 2>/dev/null || true
        if ! _wait_gone "$pid"; then
            echo "ERROR: command heartbeat did not stop (PID $pid)." >&2
            return 1
        fi
    done
    rm -f "$COMMAND_PID_FILE"
}

_publish_stop() {
    python3 -m v3.control_cli stop \
        --command-id "launcher-stop-$(date +%s%N)-$$" >/dev/null 2>&1
}

_robot_stop() {
    local result=0
    _stop_heartbeat || result=1
    _publish_stop || result=1
    _trigger_movement_capture_if_needed || true
    rm -f "$MOVEMENT_CAPTURE_FILE"
    if (( result != 0 )); then
        echo "ERROR: STOP could not be completed; requesting runtime shutdown." >&2
        _runtime_kill
    fi
    return "$result"
}

_runtime_kill() {
    local pid=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    [[ -z "$pid" ]] && return 0
    kill -TERM "$pid" 2>/dev/null || true
}

_panic() {
    _runtime_stop
}

trap 'trap "" INT TERM; _panic; exit 130' INT
trap 'trap "" INT TERM; _panic; exit 143' TERM

_status_json() {
    python3 -m v3.control_cli status 2>/dev/null
}

_status_ready() {
    local s=""
    s="$(_status_json)" || return 1
    [[ "$s" == *'"state": "RUNNING"'* && "$s" == *'"ready_for_active": true'* ]]
}

_tick_from_json() {
    local s="$1"
    if [[ "$s" =~ \"tick_id\":\ ([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "-1"
    fi
}

_status_is_fault() {
    local s="$1"
    [[ "$s" != *'"state": "RUNNING"'* ]] && return 0
    [[ "$s" == *'"safety_decision": "FAULT"'* ]] && return 0
    [[ "$s" != *'"fault_layer": null'* ]] && return 0
    return 1
}

_status_has_real_allow() {
    local s="$1"
    [[ "$s" == *'"state": "RUNNING"'* ]] || return 1
    [[ "$s" == *'"safety_decision": "ALLOW"'* ]] || return 1
    [[ "$s" == *'"enabled": true'* ]] || return 1

    STATUS_JSON="$s" python3 -c '
import json, os, sys
d=json.loads(os.environ["STATUS_JSON"])
l=d.get("left_output"); r=d.get("right_output")
ok=isinstance(l,(int,float)) and isinstance(r,(int,float)) and (abs(float(l))>1e-9 or abs(float(r))>1e-9)
sys.exit(0 if ok else 1)
'
}

_show_capture_mode() {
    local mode=""
    mode="$(_current_capture_mode 2>/dev/null || true)"
    [[ -n "$mode" ]] && echo "capture: $(_capture_mode_label "$mode")"
}

_show_status() {
    local s="" pid=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    s="$(_status_json)" || true

    if [[ -z "$s" ]]; then
        [[ -n "$pid" ]] && echo "runtime: RUNNING (status unavailable/booting)" || echo "runtime: STOPPED"
        _show_capture_mode
        return
    fi

    STATUS_JSON="$s" RUNTIME_PID="$pid" python3 - <<'PY'
import json, os
d=json.loads(os.environ["STATUS_JSON"])
state=d.get("state","UNKNOWN")
print(f"runtime: {state}")
if os.environ.get("RUNTIME_PID"):
    print(f"pid:     {os.environ['RUNTIME_PID']}")
if state=="RUNNING":
    ready=d.get("ready_for_active")
    print(f"ready:   {'YES' if ready is True else 'NO' if ready is False else '-'}")
    print(f"tick:    {d.get('tick_id','-')}")
    print(f"safety:  {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
else:
    r=d.get("report") or {}
    print(f"reason:  {r.get('final_reason') or r.get('exit_reason') or d.get('error') or '-'}")
    if r.get("fault_layer"):
        print(f"fault:   {r['fault_layer']}")
PY
    _show_capture_mode
}

_show_diag() {
    local s="" pid=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    s="$(_status_json)" || true

    if [[ -z "$s" ]]; then
        [[ -n "$pid" ]] && echo "R2B4 runtime: RUNNING (status unavailable/booting)" || echo "R2B4 runtime: STOPPED"
        _show_capture_mode
        [[ -s "$RUNTIME_LOG" ]] && { echo; echo "Last runtime log:"; tail -n 20 "$RUNTIME_LOG"; }
        return
    fi

    STATUS_JSON="$s" RUNTIME_PID="$pid" python3 - <<'PY'
import json, math, os
d=json.loads(os.environ["STATUS_JSON"])
state=d.get("state","UNKNOWN")
print(f"R2B4 runtime: {state}")
if os.environ.get("RUNTIME_PID"):
    print(f"PID:          {os.environ['RUNTIME_PID']}")

if state=="RUNNING":
    ready=d.get("ready_for_active")
    print(f"Ready:        {'YES' if ready is True else 'NO' if ready is False else '-'}")
    print(f"Tick:         {d.get('tick_id','-')}")
    print(f"Fault layer:  {d.get('fault_layer') or '-'}")
    print(f"Safety:       {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
    print(f"Motors:       {d.get('left_output','-')} / {d.get('right_output','-')}")
    for h in d.get("source_health") or []:
        reason=f" ({h.get('reason')})" if h.get("reason") else ""
        print(f"{h.get('device_id','?')}: {h.get('state','?')}{reason}")
    e=d.get("estimate")
    if isinstance(e,dict):
        yaw=e.get("yaw_rad")
        yaw=math.degrees(yaw) if isinstance(yaw,(int,float)) else None
        print(f"x:            {e.get('x_m','-')} m")
        print(f"y:            {e.get('y_m','-')} m")
        print(f"yaw:          {yaw:.2f} deg" if yaw is not None else "yaw:          -")
        print(f"v:            {e.get('v_mps','-')} m/s")
        print(f"omega:        {e.get('omega_rad_s','-')} rad/s")
else:
    r=d.get("report") or {}
    print(f"Exit reason:  {r.get('exit_reason','-')}")
    print(f"Lifecycle:    {r.get('final_lifecycle','-')}")
    print(f"Safety:       {r.get('final_safety_decision','-')} / {r.get('final_reason','-')}")
    print(f"Fault layer:  {r.get('fault_layer') or '-'}")
    print(f"Termination:  {r.get('termination_class','-')}")
    if d.get("error"):
        print(f"Error:        {d.get('error_type','ERROR')}: {d.get('error')}")
PY
    _show_capture_mode

    [[ "$s" != *'"state": "RUNNING"'* && -s "$RUNTIME_LOG" ]] && {
        echo
        echo "Last runtime log:"
        tail -n 20 "$RUNTIME_LOG"
    }
}

_new_capture_path() {
    echo "$CAPTURE_DIR/v3_$(date '+%Y%m%d_%H%M%S')_$$_capture.mcap"
}

_current_capture() {
    [[ -r "$CAPTURE_PATH_FILE" ]] && cat "$CAPTURE_PATH_FILE"
}

_capture_used() {
    local mode="" p=""
    mode="$(_current_capture_mode 2>/dev/null || true)"
    [[ "$mode" == "alap" ]] || return 1
    [[ -e "$CAPTURE_USED_FILE" ]] && return 0
    p="$(_current_capture)"
    [[ -n "$p" && -f "$p" ]]
}

_capture_ready() {
    local path="$1"
    [[ -f "$path" && ! -L "$path" ]] || return 1
    CAPTURE_FILE="$path" python3 - <<'PY' >/dev/null 2>&1
import os
from pathlib import Path
from v3.mcap_reader import EVENT_TOPIC, McapReader, McapReadError
p=Path(os.environ["CAPTURE_FILE"])
try:
    reader=McapReader(p)
    reader.capture_integrity()
    pair=reader.last_json(EVENT_TOPIC)
    final=pair[1] if pair else {}
except (OSError, ValueError, McapReadError):
    raise SystemExit(1)
raise SystemExit(0 if final.get("complete") is True else 1)
PY
}

_test_hub_evidence_dir() {
    echo "$1.evidence_next"
}

_run_test_hub_default() {
    local capture="$1" evidence
    evidence="$(_test_hub_evidence_dir "$capture")"
    echo "TEST_HUB_AUTORUN START capture=${capture#"$ROOT"/}"
    # Intentionally use the integrated stable entry point and its defaults:
    # Next generation, 5 Hz agent view, incident replay, canonical V2 backend.
    local rc=0
    python3 -m v3.test_hub run "$capture" || rc=$?
    if (( rc == 0 )); then
        echo "TEST_HUB_AUTORUN PASS evidence=${evidence#"$ROOT"/}"
        return 0
    fi
    echo "TEST_HUB_AUTORUN FAIL rc=$rc capture=${capture#"$ROOT"/}" >&2
    return "$rc"
}

_test_hub_supervisor() {
    local capture="$1" runtime_pid="$2" mode="$3" i

    # Triggered captures can become immutable before the resident runtime exits,
    # so analyze them as soon as integrity/finalization is observable.
    if [[ "$mode" == "alap" ]]; then
        while _pid_has_arg "$runtime_pid" "v3_process_runtime.py"; do
            if _capture_ready "$capture"; then
                _run_test_hub_default "$capture" || true
                return 0
            fi
            sleep 0.20
        done
    else
        # FULL is final only at runtime shutdown. NINCS deliberately has no
        # capture producer; sleeping here keeps capture-off overhead negligible.
        while _pid_has_arg "$runtime_pid" "v3_process_runtime.py"; do
            sleep 0.50
        done
    fi

    # Native process shutdown includes capture_session.finalize(). Give the
    # final file a bounded visibility/integrity window before declaring timeout.
    for i in {1..100}; do
        if _capture_ready "$capture"; then
            _run_test_hub_default "$capture" || true
            return 0
        fi
        sleep 0.10
    done

    echo "TEST_HUB_AUTORUN capture wait timeout: ${capture#"$ROOT"/}" >&2
    # Required invariant: attempt the new Test Hub once even when no capture
    # exists (notably c nincs). It will return a clear missing-capture ERROR.
    _run_test_hub_default "$capture" || true
}

# Detached supervisor: owns native process lifetime plus exactly one Test Hub
# autorun for the launcher-managed session.
_runtime_session() {
    local capture="$1" mode="$2" pid hub_pid evidence
    local -a command=(python3 v3_process_runtime.py --approval native-resident-v3)

    case "$mode" in
        alap)
            command+=(
                --capture-path "${capture#"$ROOT"/}"
                --capture-mode triggered
                --capture-pre-event-ns 8000000000
                --capture-post-event-ns 2000000000
                --capture-max-ticks 768
                --capture-max-raw-scans 128
            )
            ;;
        full)
            command+=(
                --capture-path "${capture#"$ROOT"/}"
                --capture-mode append_only
                # Effectively session-unbounded for practical robot runs while
                # retaining the runtime's required positive hard-bound contract.
                --capture-max-session-records 2147483647
            )
            ;;
        nincs)
            # True capture OFF: deliberately no --capture-path and therefore no
            # McapCaptureSession / ObservationHub capture subscription/writer.
            ;;
        *)
            echo "ERROR: internal invalid capture mode: $mode" >&2
            return 2
            ;;
    esac

    "${command[@]}" &
    pid=$!
    echo "$pid" >"$RUNTIME_PID_FILE"
    chmod 600 "$RUNTIME_PID_FILE" 2>/dev/null || true

    _test_hub_supervisor "$capture" "$pid" "$mode" &
    hub_pid=$!

    trap 'kill -TERM "$pid" 2>/dev/null || true' INT TERM
    wait "$pid"
    # A signal can interrupt wait before the native shutdown/finalizer finishes.
    while _pid_has_arg "$pid" "v3_process_runtime.py"; do wait "$pid"; done
    trap '' INT TERM

    # Keep this detached session alive until the one Test Hub autorun finishes.
    wait "$hub_pid" 2>/dev/null || true

    evidence="$(_test_hub_evidence_dir "$capture")"
    if [[ -f "$capture" ]]; then
        echo "capture: finalized -> ${capture#"$ROOT"/}"
        if [[ -d "$evidence" ]]; then
            echo "test hub: results -> ${evidence#"$ROOT"/}"
        else
            echo "WARNING: finalized MCAP exists but Test Hub evidence directory is missing: $evidence" >&2
        fi
    else
        echo "capture: no finalized MCAP for this runtime session"
    fi
}

_runtime_start() {
    local mode="${1:-$CAPTURE_MODE}" old="" fresh status_baseline="" pid="" supervisor i
    case "$mode" in alap|full|nincs) ;; *) echo "ERROR: invalid capture mode: $mode" >&2; return 2;; esac
    old="$(_runtime_pid 2>/dev/null || true)"

    if [[ -n "$old" ]]; then
        echo "runtime: existing instance -> STOP"
        _runtime_stop || return 1
        echo "runtime: waiting 5 s"
        sleep 5
        if _pid_has_arg "$old" "v3_process_runtime.py"; then
            echo "ERROR: old runtime still running (PID $old). New runtime not started." >&2
            return 1
        fi
        rm -f "$RUNTIME_PID_FILE"
    else
        _stop_heartbeat || return 1
    fi

    # A missing mailbox is canonical STOP. An empty/malformed JSON file faults
    # the gateway; remove the stale command only after the old writers exit.
    rm -f -- "$COMMAND_FILE" || return 1
    status_baseline="$(_status_json 2>/dev/null || true)"

    fresh="$(_new_capture_path)"
    echo "$fresh" >"$CAPTURE_PATH_FILE"
    echo "$mode" >"$CAPTURE_MODE_FILE"
    chmod 600 "$CAPTURE_PATH_FILE" "$CAPTURE_MODE_FILE" 2>/dev/null || true
    rm -f "$CAPTURE_USED_FILE" "$MOVEMENT_CAPTURE_FILE"

    RUNTIME_LOG="$(mktemp /tmp/r2b4-runtime.XXXXXXXX.log)" || return 1
    echo "$RUNTIME_LOG" >"$RUNTIME_DIR/.r2b4_runtime_log"
    rm -f "$RUNTIME_PID_FILE"
    nohup bash "$ROOT/r2b4" __runtime-session "$fresh" "$mode" \
        </dev/null >"$RUNTIME_LOG" 2>&1 &
    supervisor=$!
    for i in {1..40}; do
        [[ -r "$RUNTIME_PID_FILE" ]] && read -r pid <"$RUNTIME_PID_FILE"
        [[ -n "$pid" ]] && break
        kill -0 "$supervisor" 2>/dev/null || break
        sleep 0.05
    done

    sleep 0.20
    if ! _pid_has_arg "$pid" "v3_process_runtime.py"; then
        rm -f "$RUNTIME_PID_FILE"
        echo "ERROR: runtime failed to start." >&2
        [[ -s "$RUNTIME_LOG" ]] && tail -n 30 "$RUNTIME_LOG" >&2
        return 1
    fi
    if ! _wait_fresh_ready "$pid" "$status_baseline"; then
        echo "ERROR: runtime did not publish a fresh ready status." >&2
        _show_diag >&2
        _runtime_stop || true
        return 1
    fi

    echo "runtime: STARTED (PID $pid)"
    case "$mode" in
        alap)
            echo "capture: ARMED (ALAP, native MCAP 8+2 bounded ring)"
            echo "capture file: ${fresh#"$ROOT"/}"
            ;;
        full)
            echo "capture: RECORDING (FULL append-only until runtime shutdown)"
            echo "capture file: ${fresh#"$ROOT"/}"
            ;;
        nincs)
            echo "capture: OFF (no native capture consumer/writer)"
            echo "test hub: will attempt once after shutdown and report missing capture"
            ;;
    esac
    echo "runtime log: $RUNTIME_LOG"
    [[ "${R2B4_CTRL_C_HOOK:-0}" != "1" ]] && \
        echo "note: global Ctrl+C panic hook inactive; source $ROOT/r2b4"
    return 0
}

_wait_triggered_capture_tail() {
    local mode="" path="" i
    mode="$(_current_capture_mode 2>/dev/null || true)"
    [[ "$mode" == "alap" ]] || return 0
    path="$(_current_capture)"
    [[ -n "$path" && -e "$CAPTURE_USED_FILE" ]] || return 0
    _capture_ready "$path" && return 0

    echo "capture: waiting for 2 s post-event tail/finalization"
    for i in {1..70}; do
        _capture_ready "$path" && return 0
        sleep 0.05
    done
    echo "WARNING: bounded capture was not finalized before runtime shutdown; native finalizer will finish it." >&2
    return 0
}

_runtime_stop() {
    local pid="" i result=0
    _robot_stop || result=1
    pid="$(_runtime_pid 2>/dev/null || true)"
    if [[ -z "$pid" ]]; then
        echo "runtime: already STOPPED"
        return "$result"
    fi

    # In ALAP mode, if nothing has triggered the one-shot capture yet, make
    # shutdown itself the event. Then keep the already-stopped robot runtime
    # alive long enough for the requested +2 s tail before SIGTERM.
    if [[ "$(_current_capture_mode 2>/dev/null || true)" == "alap" ]]; then
        if ! _capture_used; then
            _trigger_current_capture "runtime-shutdown" || true
        fi
        _wait_triggered_capture_tail
    fi

    kill -TERM "$pid" 2>/dev/null || true
    for i in {1..200}; do
        if ! _pid_has_arg "$pid" "v3_process_runtime.py"; then
            rm -f "$RUNTIME_PID_FILE"
            echo "runtime: STOPPED (PID $pid)"
            local capture evidence mode
            capture="$(_current_capture)"
            mode="$(_current_capture_mode 2>/dev/null || true)"
            evidence="$(_test_hub_evidence_dir "$capture")"
            if [[ -n "$capture" && -f "$capture" ]]; then
                echo "capture: ${capture#"$ROOT"/}"
                [[ -d "$evidence" ]] && echo "test hub: ${evidence#"$ROOT"/}" || \
                    echo "test hub: finalization/analysis continuing in runtime log"
            elif [[ "$mode" == "nincs" ]]; then
                echo "capture: OFF"
                echo "test hub: missing-capture check continuing in runtime log"
            else
                echo "capture: no finalized MCAP for this runtime session"
            fi
            echo "runtime log: $RUNTIME_LOG"
            return "$result"
        fi
        sleep 0.05
    done
    echo "ERROR: runtime did not exit after shutdown (PID $pid)." >&2
    return 1
}

_ensure_runtime() {
    local requested="${1:-$CAPTURE_MODE}" pid="" current=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    if [[ -n "$pid" ]]; then
        current="$(_current_capture_mode 2>/dev/null || echo alap)"
        if [[ "$current" == "$requested" ]]; then
            return 0
        fi
        echo "runtime: capture mode $current -> $requested requires safe restart"
    fi
    _runtime_start "$requested"
}

_wait_idle() {
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 0
    python3 - "$STATUS_FILE" "$COMMAND_FILE" <<'PY'
import json, sys, time
from pathlib import Path
from v3.control_cli import _read_status
command = json.loads(Path(sys.argv[2]).read_text())
if command.get("mode") != "STOP":
    raise SystemExit("ERROR: another command replaced STOP before IDLE confirmation.")
issued_ns = command["issued_monotonic_ns"]
deadline = time.monotonic() + 3.0
while time.monotonic() < deadline:
    try:
        s = _read_status(Path(sys.argv[1]))
        age = time.monotonic_ns() - s.get("monotonic_ns", 0)
        if (s.get("state") == "RUNNING" and 0 <= age < 500_000_000
                and s.get("monotonic_ns", 0) > issued_ns
                and s.get("ready_for_active") is True
                and s.get("safety_decision") == "STOP"
                and s.get("enabled") is False
                and s.get("left_output") == s.get("right_output") == 0):
            raise SystemExit(0)
        if s.get("state") != "RUNNING" or s.get("fault_layer") or s.get("safety_decision") == "FAULT":
            break
    except ValueError:
        break
    time.sleep(0.05)
print("ERROR: runtime did not confirm ready IDLE with inactive outputs.", file=sys.stderr)
raise SystemExit(1)
PY
}

_wait_ready() {
    local i
    for i in {1..160}; do
        [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 1
        _status_ready && return 0
        sleep 0.05
    done
    return 1
}

_wait_fresh_ready() {
    local pid="$1" baseline="$2" s="" i
    for i in {1..160}; do
        _pid_has_arg "$pid" "v3_process_runtime.py" || return 1
        s="$(_status_json)" || { sleep 0.05; continue; }
        if [[ "$s" != "$baseline" &&
              "$s" == *'"state": "RUNNING"'* &&
              "$s" == *'"ready_for_active": true'* ]]; then
            return 0
        fi
        sleep 0.05
    done
    return 1
}

_ensure_fresh_capture_slot() {
    local mode=""
    mode="$(_current_capture_mode 2>/dev/null || true)"
    [[ "$mode" == "alap" ]] || return 0
    if ! _capture_used; then
        return 0
    fi

    echo "capture: previous bounded slot used -> re-arm requires runtime restart"
    _runtime_start "alap" || return 1
    _wait_ready || {
        echo "ERROR: restarted runtime not ready." >&2
        _show_diag >&2
        return 1
    }
}

_trigger_current_capture() {
    local origin="$1" pid="" path="" mode=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    [[ -n "$pid" ]] || { echo "ERROR: runtime is not running." >&2; return 1; }
    mode="$(_current_capture_mode 2>/dev/null || true)"
    case "$mode" in
        full)
            echo "capture: FULL already records continuously; trigger not required"
            return 0
            ;;
        nincs)
            echo "ERROR: capture is OFF (c nincs)." >&2
            return 1
            ;;
        alap) ;;
        *) echo "ERROR: unknown runtime capture mode." >&2; return 1;;
    esac

    path="$(_current_capture)"
    [[ -n "$path" ]] || { echo "ERROR: no launcher-managed capture path." >&2; return 1; }

    # If the file/launcher marker already exists, the native one-shot worker
    # has already been used. Do not pretend a second trigger is possible.
    _capture_used && return 0

    kill -USR1 "$pid" 2>/dev/null || { echo "ERROR: capture trigger failed." >&2; return 1; }
    printf 'origin=%s\ntriggered_at_ns=%s\n' "$origin" "$(date +%s%N)" >"$CAPTURE_USED_FILE"
    chmod 600 "$CAPTURE_USED_FILE" 2>/dev/null || true

    echo "capture: TRIGGERED ($origin)"
    echo "capture file: ${path#"$ROOT"/}"
}

_trigger_capture() {
    local origin="$1"
    _ensure_runtime "$CAPTURE_MODE" || return 1
    case "$CAPTURE_MODE" in
        alap)
            _ensure_fresh_capture_slot || return 1
            _trigger_current_capture "$origin"
            ;;
        full)
            echo "capture: FULL already recording"
            ;;
        nincs)
            echo "ERROR: capture is OFF (c nincs)." >&2
            return 1
            ;;
    esac
}

_trigger_movement_capture_if_needed() {
    [[ "$(_current_capture_mode 2>/dev/null || true)" == "alap" ]] || return 0
    [[ -e "$MOVEMENT_CAPTURE_FILE" ]] || return 0
    _capture_used && return 0
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 0
    _trigger_current_capture "movement-stop"
}

_capture_status() {
    local path="" mode=""
    mode="$(_current_capture_mode 2>/dev/null || true)"
    path="$(_current_capture)"

    if [[ "$mode" == "nincs" ]]; then
        echo "capture: OFF"
        [[ -n "$path" ]] && echo "expected file (not produced): ${path#"$ROOT"/}"
        return
    fi
    [[ -n "$path" ]] || { echo "capture: NOT ARMED"; return; }

    if [[ -f "$path" ]]; then
        CAPTURE_FILE="$path" CAPTURE_MODE_VALUE="$mode" python3 - <<'PY'
import os
from pathlib import Path
from v3.mcap_reader import EVENT_TOPIC, McapReader, McapReadError

p = Path(os.environ["CAPTURE_FILE"])
mode = os.environ.get("CAPTURE_MODE_VALUE", "-")
try:
    reader = McapReader(p)
    final_pair = reader.last_json(EVENT_TOPIC)
    final = final_pair[1] if final_pair else {}
    reader.capture_integrity()
    integrity_ok = True
except (OSError, ValueError, McapReadError):
    final = {}
    integrity_ok = False

print("capture: FINALIZED" if integrity_ok and final.get("complete") is True else "capture: RECORDING / FINALIZING")
print(f"mode:    {mode}")
print(f"file:    {p}")
print(f"status:  {final.get('status','-')}")
print(f"ticks:   {final.get('captured_tick_count','-')}")
print(f"trigger: {final.get('trigger_reason','-')}")
print(f"complete:{' YES' if final.get('complete') is True and integrity_ok else ' NO'}")
evidence = p.with_name(p.name + ".evidence_next")
print(f"evidence:{' ' + str(evidence) if evidence.is_dir() else ' -'}")
PY
    elif [[ "$mode" == "full" ]]; then
        echo "capture: FULL recording (file not yet finalized/visible)"
        echo "file:    ${path#"$ROOT"/}"
    elif [[ -e "$CAPTURE_USED_FILE" ]]; then
        echo "capture: TRIGGERED / finalizing"
        echo "file:    ${path#"$ROOT"/}"
    elif [[ -e "$MOVEMENT_CAPTURE_FILE" ]]; then
        echo "capture: ARMED for movement (will save on STOP/FAULT)"
        echo "file:    ${path#"$ROOT"/}"
    else
        echo "capture: ARMED"
        echo "file:    ${path#"$ROOT"/}"
    fi
}

_capture_stop() {
    local path="" mode="" i
    mode="$(_current_capture_mode 2>/dev/null || true)"
    path="$(_current_capture)"
    [[ -n "$path" ]] || { echo "capture: NOT ARMED"; return 1; }

    case "$mode" in
        nincs)
            echo "capture: OFF"
            return 0
            ;;
        full)
            echo "capture: FULL remains continuous until runtime stop/shutdown"
            echo "file:    ${path#"$ROOT"/}"
            return 0
            ;;
        alap) ;;
    esac

    if [[ -e "$MOVEMENT_CAPTURE_FILE" && ! -e "$CAPTURE_USED_FILE" && ! -f "$path" ]]; then
        _trigger_current_capture "capture-stop" || return 1
    fi

    if [[ ! -e "$CAPTURE_USED_FILE" && ! -f "$path" ]]; then
        echo "capture: no triggered capture"
        return
    fi
    for i in {1..70}; do
        _capture_ready "$path" && break
        sleep 0.05
    done
    if [[ -f "$path" ]]; then
        _capture_status
    else
        echo "capture: still finalizing"
        echo "file:    ${path#"$ROOT"/}"
    fi
}

_valid_speed() {
    python3 - "$1" <<'PY'
import math, sys
try: v=float(sys.argv[1])
except ValueError: raise SystemExit(1)
raise SystemExit(0 if math.isfinite(v) and 0.0 < v <= 0.50 else 1)
PY
}

_failure_report() {
    local label="$1"
    local saved="${2:-}"
    local s="$saved"
    echo "ERROR: $label did not reach motor ALLOW." >&2
    [[ -z "$s" ]] && s="$(_status_json)" || true
    if [[ -n "$s" ]]; then
        echo >&2
        STATUS_JSON="$s" python3 - <<'PY' >&2
import json, os
d=json.loads(os.environ["STATUS_JSON"])
print(f"state:       {d.get('state','-')}")
print(f"tick:        {d.get('tick_id','-')}")
print(f"fault layer: {d.get('fault_layer') or '-'}")
print(f"safety:      {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
print(f"motors:      {d.get('left_output','-')} / {d.get('right_output','-')}")
r=d.get("report") or {}
if r:
    print(f"final:       {r.get('final_safety_decision','-')} / {r.get('final_reason','-')}")
    print(f"termination: {r.get('termination_class','-')}")
PY
    fi
    [[ -s "$COMMAND_LOG" ]] && { echo >&2; echo "Command log:" >&2; tail -n 20 "$COMMAND_LOG" >&2; }
    [[ -s "$RUNTIME_LOG" ]] && { echo >&2; echo "Runtime log:" >&2; tail -n 20 "$RUNTIME_LOG" >&2; }
}

_wait_allow() {
    local cpid="$1" baseline="$2" label="$3" s="" tick i
    for i in {1..50}; do
        if ! _pid_has_arg "$cpid" "v3.control_cli"; then
            _failure_report "$label" "$s"
            return 1
        fi
        if [[ -z "$(_runtime_pid 2>/dev/null || true)" ]]; then
            _stop_heartbeat || true
            _failure_report "$label"
            return 1
        fi

        s="$(_status_json)" || { sleep 0.05; continue; }
        tick="$(_tick_from_json "$s")"
        if (( tick > baseline )); then
            if _status_is_fault "$s"; then
                local bad="$s"
                _trigger_movement_capture_if_needed || true
                _stop_heartbeat || true
                _publish_stop || true
                rm -f "$MOVEMENT_CAPTURE_FILE"
                _failure_report "$label" "$bad"
                return 1
            fi
            _status_has_real_allow "$s" && return 0
        fi
        sleep 0.05
    done

    local last="$s"
    _trigger_movement_capture_if_needed || true
    _stop_heartbeat || true
    _publish_stop || true
    rm -f "$MOVEMENT_CAPTURE_FILE"
    _failure_report "$label" "$last"
    return 1
}

_start_motion() {
    local label="$1" capture="$2"
    shift 2
    local s="" baseline="-1" cpid mode

    _ensure_runtime "$CAPTURE_MODE" || return 1

    _robot_stop || return 1
    _wait_idle || { _show_diag >&2; return 1; }

    mode="$(_current_capture_mode 2>/dev/null || echo alap)"
    if [[ "$mode" == "alap" && "$capture" == "yes" ]]; then
        _ensure_fresh_capture_slot || return 1
        _wait_ready || { echo "ERROR: runtime not ready after capture re-arm." >&2; return 1; }
        echo "movement" >"$MOVEMENT_CAPTURE_FILE"
        chmod 600 "$MOVEMENT_CAPTURE_FILE" 2>/dev/null || true
    else
        rm -f "$MOVEMENT_CAPTURE_FILE"
    fi

    s="$(_status_json)" || true
    [[ -n "$s" ]] && baseline="$(_tick_from_json "$s")"

    COMMAND_LOG="$(mktemp /tmp/r2b4-command.XXXXXXXX.log)" || return 1
    echo "$COMMAND_LOG" >"$RUNTIME_DIR/.r2b4_command_log"
    nohup "$@" </dev/null >"$COMMAND_LOG" 2>&1 &
    cpid=$!
    echo "$cpid" >"$COMMAND_PID_FILE"
    chmod 600 "$COMMAND_PID_FILE" 2>/dev/null || true

    _wait_allow "$cpid" "$baseline" "$label" || return 1

    echo "$label: STARTED"
    echo "motor: ALLOW confirmed"
    case "$mode" in
        alap)
            if [[ "$capture" == "yes" ]]; then
                local p="$(_current_capture)"
                echo "capture: ALAP armed for STOP/FAULT -> ${p#"$ROOT"/}"
            else
                echo "capture: movement trigger skipped by legacy nocapture"
            fi
            ;;
        full)
            echo "capture: FULL continuous recording"
            [[ "$capture" == "no" ]] && echo "note: legacy nocapture does not disable explicit c full"
            ;;
        nincs)
            echo "capture: OFF"
            ;;
    esac
}

_forward() {
    local speed="0.15" speed_set="no" capture="yes" a
    shift 2
    for a in "$@"; do
        if [[ "$a" == "nocapture" ]]; then
            capture="no"
        elif [[ "$speed_set" == "no" ]]; then
            speed="$a"; speed_set="yes"
        else
            echo "ERROR: invalid forward arguments." >&2; return 2
        fi
    done
    _valid_speed "$speed" || { echo "ERROR: speed must be >0 and <=0.50 m/s." >&2; return 1; }

    _start_motion "forward $speed m/s" "$capture" \
        python3 -m v3.control_cli teleop \
        --command-id "launcher-forward-$(date +%s%N)-$$" \
        --v-mps "$speed" --omega-rad-s 0 \
        --max-v-mps "$speed" --max-omega-rad-s 0.60
}

_wheel_targets_to_twist() {
    python3 - "$ROOT/conf/fizika.json" "$1" "$2" <<'PY'
import json
import math
import sys
from pathlib import Path

physics_path = Path(sys.argv[1])
try:
    left_mps = float(sys.argv[2])
    right_mps = float(sys.argv[3])
except ValueError:
    print("ERROR: left_mps and right_mps must be numeric.", file=sys.stderr)
    raise SystemExit(1)

if not math.isfinite(left_mps) or not math.isfinite(right_mps):
    print("ERROR: wheel speeds must be finite.", file=sys.stderr)
    raise SystemExit(1)
if abs(left_mps) > 0.50 or abs(right_mps) > 0.50:
    print("ERROR: each wheel speed must be within [-0.50, 0.50] m/s.", file=sys.stderr)
    raise SystemExit(1)
if abs(left_mps) <= 1e-12 and abs(right_mps) <= 1e-12:
    print("ERROR: both wheel targets are zero; use ./r2b4 stop.", file=sys.stderr)
    raise SystemExit(1)

try:
    physics = json.loads(physics_path.read_text(encoding="utf-8"))
    track_width_m = float(physics["nyomtav_szelesseg_m"])
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
    print(f"ERROR: cannot read valid track width from {physics_path}: {exc}", file=sys.stderr)
    raise SystemExit(1)
if not math.isfinite(track_width_m) or track_width_m <= 0.0:
    print("ERROR: nyomtav_szelesseg_m must be finite and positive.", file=sys.stderr)
    raise SystemExit(1)

# Exact inverse of V3 L10 differential-drive kinematics:
# left = v - omega * track/2
# right = v + omega * track/2
v_mps = 0.5 * (left_mps + right_mps)
omega_rad_s = (right_mps - left_mps) / track_width_m

# The resident command gateway is still the ingress authority. Reject only a
# target that it cannot represent at all; lower L5-L12 constraints may further
# reduce the executed motion and remain authoritative.
if abs(v_mps) > 0.50 + 1e-12:
    print(f"ERROR: wheel pair requires v={v_mps:.6f} m/s above the resident 0.50 m/s limit.", file=sys.stderr)
    raise SystemExit(1)
if abs(omega_rad_s) > 1.20 + 1e-12:
    print(
        f"ERROR: wheel pair requires omega={omega_rad_s:.6f} rad/s "
        "above the resident 1.20 rad/s limit.",
        file=sys.stderr,
    )
    raise SystemExit(1)

# TELEOP declares positive limits even when one target component is exactly 0.
max_v_mps = max(abs(v_mps), 1e-6)
max_omega_rad_s = max(abs(omega_rad_s), 1e-6)
print(
    f"{v_mps:.12g} {omega_rad_s:.12g} "
    f"{max_v_mps:.12g} {max_omega_rad_s:.12g} {track_width_m:.12g}"
)
PY
}

_mozog() {
