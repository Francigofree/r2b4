_proba() {
    local cpid result mode
    _ensure_runtime "$CAPTURE_MODE" || return 1
    _robot_stop || return 1
    _wait_idle || return 1
    mode="$(_current_capture_mode 2>/dev/null || echo alap)"
    if [[ "$mode" == "alap" ]]; then
        _ensure_fresh_capture_slot || return 1
        echo "movement" >"$MOVEMENT_CAPTURE_FILE"
        chmod 600 "$MOVEMENT_CAPTURE_FILE" 2>/dev/null || true
    else
        rm -f "$MOVEMENT_CAPTURE_FILE"
    fi

    # One interruptible command producer owns the whole sequence, including
    # pauses. External STOP terminates it before publishing the final STOP.
    python3 - r2b4-proba "$ROOT" <<'PY' &
import json, math, os, signal, sys, time
from pathlib import Path
from v3.adapters.resident_command import ResidentCommandClient, ResidentCommandMailboxConfig
from v3.control_cli import _read_status

root = Path(sys.argv[2])
client = ResidentCommandClient(ResidentCommandMailboxConfig(path=root / "runtime/v3_command.json"))
status_path = root / "runtime/v3_status.json"
command_id = f"launcher-proba-{os.getpid()}-{time.monotonic_ns()}"
ttl_ns = 200_000_000

def interrupted(signum, frame):
    raise KeyboardInterrupt

signal.signal(signal.SIGINT, interrupted)
signal.signal(signal.SIGTERM, interrupted)

def status():
    s = _read_status(status_path)
    age = time.monotonic_ns() - s.get("monotonic_ns", 0)
    if (s.get("state") != "RUNNING" or not 0 <= age < 500_000_000
            or s.get("fault_layer") or s.get("safety_decision") == "FAULT"
            or any(h.get("state") != "OK" for h in s.get("source_health", []))):
        raise RuntimeError(f"runtime/health/timing failure: {s}")
    return s

def stopped(s):
    return (s.get("safety_decision") == "STOP" and s.get("enabled") is False
            and s.get("left_output") == s.get("right_output") == 0
            and s.get("ready_for_active") is True)

def stop():
    client.publish_stop(command_id + "-stop", ttl_ns=ttl_ns)

def idle(pause):
    issued_ns = time.monotonic_ns()
    stop()
    deadline = time.monotonic() + 3.0
    while True:
        s = status()
        if s["monotonic_ns"] > issued_ns and stopped(s):
            break
        if time.monotonic() >= deadline:
            raise RuntimeError("IDLE was not confirmed")
        time.sleep(0.05)
    deadline = time.monotonic() + pause
    while time.monotonic() < deadline:
        if not stopped(status()):
            raise RuntimeError("runtime left IDLE during pause")
        time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))

def yaw(s):
    value = (s.get("estimate") or {}).get("yaw_rad")
    if not isinstance(value, (int, float)) or not math.isfinite(value):
        raise RuntimeError("missing/invalid runtime yaw")
    return value

def phase(index, label, target, angle=0.0):
    print(f"proba {index}/10: {label}", flush=True)
    initial = status()
    if not stopped(initial):
        raise RuntimeError("phase requires ready IDLE")
    previous_yaw = yaw(initial) if angle else 0.0
    turned = 0.0
    started = time.monotonic()
    published_ns = time.monotonic_ns()
    allowed = False
    next_send = started
    while True:
        now = time.monotonic()
        elapsed = now - started
        s = status()
        if s["monotonic_ns"] > published_ns:
            if s.get("safety_decision") == "ALLOW" and s.get("enabled") is True:
                allowed = True
            elif allowed or s.get("safety_reason") != "NOT_ACTIVE":
                raise RuntimeError(f"motion stopped by safety: {s}")
        if not allowed and elapsed > 1.5:
            raise RuntimeError("phase did not reach ALLOW")
        if angle:
            current_yaw = yaw(s)
            turned += math.atan2(math.sin(current_yaw - previous_yaw), math.cos(current_yaw - previous_yaw))
            previous_yaw = current_yaw
            remaining = abs(angle) - math.copysign(1.0, angle) * turned
            if remaining <= math.radians(2):
                break
            if elapsed > 30.0:
                raise RuntimeError("turn did not reach its target within 30 s")
            # Slow down near the requested angle; wheel ratios stay unchanged.
            scale = min(1.0, max(0.15, remaining / math.radians(25)))
        else:
            if elapsed >= 5.0:
                break
            scale = 1.0
        if now - next_send > 0.08:
            raise RuntimeError("command heartbeat deadline missed")
        v, omega = target(min(1.0, elapsed / 4.9))
        client.publish_teleop(f"{command_id}-{index}", v_mps=v * scale,
                             omega_rad_s=omega * scale, max_v_mps=0.25,
                             max_omega_rad_s=0.60, ttl_ns=ttl_ns)
        next_send += 0.1
        time.sleep(max(0.0, next_send - time.monotonic()))
    idle(5.0 if index < 10 else 0.0)

try:
    track = float(json.loads((root / "conf/fizika.json").read_text())["nyomtav_szelesseg_m"])
    if not math.isfinite(track) or track <= 0:
        raise ValueError("invalid track width")
    phase(1, "előre, 5 s, 0.15–0.25 m/s", lambda t: (0.15 + 0.10 * t, 0.0))
    phase(2, "hátra, 5 s, 0.15–0.25 m/s", lambda t: (-0.15 - 0.10 * t, 0.0))
    # Right/left describes the side of the arc relative to the chassis;
    # reversing travel reverses yaw, just as for a wheel-speed pair.
    for index, label, direction, side in (
        (3, "jobbra előre", 1, -1), (4, "jobbra hátra", -1, -1),
        (5, "balra előre", 1, 1), (6, "balra hátra", -1, 1),
    ):
        phase(index, label + ", 5 s, R=2.0→0.6 m",
              lambda t: (direction * 0.15, side * direction * 0.15 / (2.0 - 1.4 * t)))
    phase(7, "helyben jobbra 90°", lambda t: (0.0, -0.4), -math.pi / 2)
    phase(8, "helyben balra 90°", lambda t: (0.0, 0.4), math.pi / 2)
    pivot_omega = min(0.4, 0.20 / track)
    phase(9, "jobbra 180°, jobb kerék célja 0", lambda t: (pivot_omega * track / 2, -pivot_omega), -math.pi)
    phase(10, "balra 180°, jobb kerék célja 0", lambda t: (-pivot_omega * track / 2, pivot_omega), math.pi)
    print("proba: kész, IDLE", flush=True)
except KeyboardInterrupt:
    print("proba: megszakítva", flush=True)
    raise SystemExit(130)
except Exception as exc:
    print(f"ERROR: proba aborted: {exc}", file=sys.stderr, flush=True)
    raise SystemExit(1)
finally:
    # Do not let a second interrupt prevent the final mailbox STOP.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    stop()
PY
    cpid=$!
    echo "$cpid" >"$COMMAND_PID_FILE"
    chmod 600 "$COMMAND_PID_FILE" 2>/dev/null || true
    wait "$cpid"
    result=$?
    # Only finish our own capture; a replacing command may already be running.
    if [[ "$(cat "$COMMAND_PID_FILE" 2>/dev/null)" == "$cpid" ]]; then
        _trigger_movement_capture_if_needed || true
        rm -f "$COMMAND_PID_FILE" "$MOVEMENT_CAPTURE_FILE"
    fi
    return "$result"
}

main() {
    _parse_capture_selector "$@" || return $?
    set -- "${CLEAN_ARGS[@]}"

    case "${1:-} ${2:-}" in
        "runtime start")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _runtime_start "$CAPTURE_MODE"
            ;;
        "runtime stop")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _runtime_stop
            ;;
        "runtime status")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _show_status
            ;;
        "runtime diag")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _show_diag
            ;;
        "capture start")
            [[ $# -eq 2 ]] || { usage; return 2; }
            # Preserve an already-running explicit mode when old syntax
            # "capture start" is used without a selector. A cold start defaults
            # to ALAP, exactly like legacy behavior.
            if (( CAPTURE_MODE_EXPLICIT == 0 )); then
                local current_mode=""
                current_mode="$(_current_capture_mode 2>/dev/null || true)"
                [[ -n "$(_runtime_pid 2>/dev/null || true)" && -n "$current_mode" ]] && \
                    CAPTURE_MODE="$current_mode"
            fi
            _trigger_capture "manual"
            ;;
        "capture stop")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _capture_stop
            ;;
        "capture status")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _capture_status
            ;;
        "forward start")
            _forward "$@"
            ;;
        "mozog start")
            _mozog "$@"
            ;;
        "roomcruise start")
            _roomcruise "$@"
            ;;
        "stop ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _robot_stop || return 1
            _wait_idle || return 1
            echo "robot: IDLE (runtime kept running if present)"
            ;;
        "shutdown ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _runtime_stop
            ;;
        "proba ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _proba
            ;;
        __runtime-session\ *)
            [[ $# -eq 3 ]] || return 2
            _runtime_session "$2" "$3"
            ;;
        "panic --quiet")
            _panic
            ;;
        "panic ")
            _panic
            echo "robot: STOP + runtime shutdown requested"
            ;;
        "help "|"--help "|"-h ")
            usage
            ;;
        *)
            usage
            return 2
            ;;
    esac
}

main "$@"
