#!/usr/bin/env bash
# R2B4 user launcher: thin wrapper over the existing native V3 runtime/CLI.
# No second robot-control or capture path is introduced.

SRC="${BASH_SOURCE[0]}"
ROOT="$(cd "$(dirname "$SRC")" && pwd)"

# Optional global Ctrl+C panic hook:
#   source /home/alba/project_r2b4/r2b4
if [[ "$SRC" != "$0" ]]; then
    export R2B4_CTRL_C_HOOK=1
    _r2b4_panic_hook() {
        printf '\nR2B4: Ctrl+C -> STOP + runtime shutdown\n' >&2
        "$ROOT/r2b4" panic --quiet >/dev/null 2>&1 || true
    }
    trap '_r2b4_panic_hook' INT
    return 0
fi

set -u
cd "$ROOT" || exit 1

RUNTIME_DIR="$ROOT/runtime"
CAPTURE_DIR="$RUNTIME_DIR/captures"
STATUS_FILE="$RUNTIME_DIR/v3_status.json"
COMMAND_FILE="$RUNTIME_DIR/v3_command.json"
RUNTIME_LOG="/tmp/r2b4-runtime-current.log"
COMMAND_LOG="/tmp/r2b4-command-current.log"
[[ -r "$RUNTIME_DIR/.r2b4_runtime_log" ]] && read -r RUNTIME_LOG <"$RUNTIME_DIR/.r2b4_runtime_log"
[[ -r "$RUNTIME_DIR/.r2b4_command_log" ]] && read -r COMMAND_LOG <"$RUNTIME_DIR/.r2b4_command_log"

RUNTIME_PID_FILE="$RUNTIME_DIR/.r2b4_runtime_pid"
COMMAND_PID_FILE="$RUNTIME_DIR/.r2b4_command_pid"
CAPTURE_PATH_FILE="$RUNTIME_DIR/.r2b4_capture_path"
CAPTURE_USED_FILE="$RUNTIME_DIR/.r2b4_capture_triggered"
MOVEMENT_CAPTURE_FILE="$RUNTIME_DIR/.r2b4_movement_capture"

mkdir -p "$RUNTIME_DIR" "$CAPTURE_DIR"

usage() {
cat <<'EOF'
Usage:
  r2b4 runtime start
  r2b4 runtime stop
  r2b4 runtime status
  r2b4 runtime diag

  r2b4 capture start
  r2b4 capture stop
  r2b4 capture status

  r2b4 forward start [speed_mps] [nocapture]
  r2b4 mozog start <left_mps> <right_mps> [nocapture]
  r2b4 roomcruise start [nocapture]

  r2b4 stop
  r2b4 shutdown
  r2b4 proba

Defaults:
  forward speed: 0.15 m/s
  mozog wheel speeds: signed m/s, each within [-0.50, 0.50]
  movement capture: ON

Capture uses the existing native bounded triggered ring:
  pre-event 5 s, post-event 2 s, max 512 ticks / 64 MiB.

Starting a movement or capture automatically starts the runtime if needed.
"stop" cancels the command producer (including proba) and returns to IDLE.
"shutdown", "runtime stop" and Ctrl+C stop the runtime as well.
After each launcher-managed runtime exits, Test Hub validates its new capture.
Results and logs use unique paths under /tmp; see the runtime log path.

"proba" runs ten slow phases in the foreground, with 5 s in IDLE between them:
  forward/reverse: 5 s each, ramping from 0.15 to 0.25 m/s;
  right-forward/right-reverse/left-forward/left-reverse arcs: 5 s each,
    radius decreasing from 2.0 to 0.6 m at 0.15 m/s;
  right/left in-place turns: 90 degrees each;
  right/left turns about the stationary right wheel: 180 degrees each.
Angles use runtime yaw feedback; safety or feedback failure aborts the test.
The final left turn moves the left wheel backwards, with the right target zero.
Capture remains the native bounded event window, not a full proba recording.

"capture start" triggers one bounded event capture.
"capture stop" waits for its automatic finalization and reports the file.

The native worker is one-shot per runtime. If a new captured movement needs
a fresh slot, the launcher re-arms it by the existing safe runtime restart
(STOP -> 5 s -> new runtime).

"mozog" accepts left/right wheel-speed targets and converts them to the
canonical TELEOP body target using conf/fizika.json track width. Existing
L5-L12 motion, operational and safety constraints remain authoritative.

"nocapture" skips movement capture arming. Native automatic FAULT capture
remains part of the runtime's existing fail evidence.

Global Ctrl+C panic at the shell prompt:
  source /home/alba/project_r2b4/r2b4
EOF
}

_pid_has_arg() {
    local pid="$1" wanted="$2" cwd arg
    local argv=()
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
    [[ "$cwd" == "$ROOT" ]] || return 1
    mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null || return 1
    for arg in "${argv[@]}"; do
        [[ "$arg" == "$wanted" ]] && return 0
    done
    return 1
}

_find_pid() {
    local wanted="$1" proc pid
    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        _pid_has_arg "$pid" "$wanted" && { echo "$pid"; return 0; }
    done
    return 1
}

_get_pid() {
    local file="$1" wanted="$2" pid=""
    if [[ -r "$file" ]]; then
        pid="$(cat "$file" 2>/dev/null || true)"
        if _pid_has_arg "$pid" "$wanted"; then
            echo "$pid"
            return 0
        fi
        rm -f "$file"
    fi
    pid="$(_find_pid "$wanted" 2>/dev/null || true)"
    if [[ -n "$pid" ]]; then
        echo "$pid" >"$file"
        chmod 600 "$file" 2>/dev/null || true
        echo "$pid"
        return 0
    fi
    return 1
}

_runtime_pid() { _get_pid "$RUNTIME_PID_FILE" "v3_process_runtime.py"; }
_command_pid() {
    _get_pid "$COMMAND_PID_FILE" "r2b4-proba" ||
        _get_pid "$COMMAND_PID_FILE" "v3.control_cli"
}

_wait_gone() {
    local pid="$1" i state
    for i in {1..20}; do
        kill -0 "$pid" 2>/dev/null || return 0
        state="$(cat "/proc/$pid/stat" 2>/dev/null || true)"
        [[ "${state##*) }" == Z* ]] && return 0
        sleep 0.05
    done
    return 1
}

_stop_heartbeat() {
    local pid=""
    while pid="$(_command_pid 2>/dev/null)"; do
        kill -TERM "$pid" 2>/dev/null || true
        if ! _wait_gone "$pid"; then
            echo "ERROR: command heartbeat did not stop (PID $pid)." >&2
            return 1
        fi
    done
    rm -f "$COMMAND_PID_FILE"
}

_publish_stop() {
    python3 -m v3.control_cli stop \
        --command-id "launcher-stop-$(date +%s%N)-$$" >/dev/null 2>&1
}

_robot_stop() {
    local result=0
    _stop_heartbeat || result=1
    _publish_stop || result=1
    _trigger_movement_capture_if_needed || true
    rm -f "$MOVEMENT_CAPTURE_FILE"
    if (( result != 0 )); then
        echo "ERROR: STOP could not be completed; requesting runtime shutdown." >&2
        _runtime_kill
    fi
    return "$result"
}

_runtime_kill() {
    local pid=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    [[ -z "$pid" ]] && return 0
    kill -TERM "$pid" 2>/dev/null || true
}

_panic() {
    _runtime_stop
}

trap 'trap "" INT TERM; _panic; exit 130' INT
trap 'trap "" INT TERM; _panic; exit 143' TERM

_status_json() {
    python3 -m v3.control_cli status 2>/dev/null
}

_status_ready() {
    local s=""
    s="$(_status_json)" || return 1
    [[ "$s" == *'"state": "RUNNING"'* && "$s" == *'"ready_for_active": true'* ]]
}

_tick_from_json() {
    local s="$1"
    if [[ "$s" =~ \"tick_id\":\ ([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "-1"
    fi
}

_status_is_fault() {
    local s="$1"
    [[ "$s" != *'"state": "RUNNING"'* ]] && return 0
    [[ "$s" == *'"safety_decision": "FAULT"'* ]] && return 0
    [[ "$s" != *'"fault_layer": null'* ]] && return 0
    return 1
}

_status_has_real_allow() {
    local s="$1"
    [[ "$s" == *'"state": "RUNNING"'* ]] || return 1
    [[ "$s" == *'"safety_decision": "ALLOW"'* ]] || return 1
    [[ "$s" == *'"enabled": true'* ]] || return 1

    STATUS_JSON="$s" python3 -c '
import json, os, sys
d=json.loads(os.environ["STATUS_JSON"])
l=d.get("left_output"); r=d.get("right_output")
ok=isinstance(l,(int,float)) and isinstance(r,(int,float)) and (abs(float(l))>1e-9 or abs(float(r))>1e-9)
sys.exit(0 if ok else 1)
'
}

_show_status() {
    local s="" pid=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    s="$(_status_json)" || true

    if [[ -z "$s" ]]; then
        [[ -n "$pid" ]] && echo "runtime: RUNNING (status unavailable/booting)" || echo "runtime: STOPPED"
        return
    fi

    STATUS_JSON="$s" RUNTIME_PID="$pid" python3 - <<'PY'
import json, os
d=json.loads(os.environ["STATUS_JSON"])
state=d.get("state","UNKNOWN")
print(f"runtime: {state}")
if os.environ.get("RUNTIME_PID"):
    print(f"pid:     {os.environ['RUNTIME_PID']}")
if state=="RUNNING":
    ready=d.get("ready_for_active")
    print(f"ready:   {'YES' if ready is True else 'NO' if ready is False else '-'}")
    print(f"tick:    {d.get('tick_id','-')}")
    print(f"safety:  {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
else:
    r=d.get("report") or {}
    print(f"reason:  {r.get('final_reason') or r.get('exit_reason') or d.get('error') or '-'}")
    if r.get("fault_layer"):
        print(f"fault:   {r['fault_layer']}")
PY
}

_show_diag() {
    local s="" pid=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    s="$(_status_json)" || true

    if [[ -z "$s" ]]; then
        [[ -n "$pid" ]] && echo "R2B4 runtime: RUNNING (status unavailable/booting)" || echo "R2B4 runtime: STOPPED"
        [[ -s "$RUNTIME_LOG" ]] && { echo; echo "Last runtime log:"; tail -n 20 "$RUNTIME_LOG"; }
        return
    fi

    STATUS_JSON="$s" RUNTIME_PID="$pid" python3 - <<'PY'
import json, math, os
d=json.loads(os.environ["STATUS_JSON"])
state=d.get("state","UNKNOWN")
print(f"R2B4 runtime: {state}")
if os.environ.get("RUNTIME_PID"):
    print(f"PID:          {os.environ['RUNTIME_PID']}")

if state=="RUNNING":
    ready=d.get("ready_for_active")
    print(f"Ready:        {'YES' if ready is True else 'NO' if ready is False else '-'}")
    print(f"Tick:         {d.get('tick_id','-')}")
    print(f"Fault layer:  {d.get('fault_layer') or '-'}")
    print(f"Safety:       {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
    print(f"Motors:       {d.get('left_output','-')} / {d.get('right_output','-')}")
    for h in d.get("source_health") or []:
        reason=f" ({h.get('reason')})" if h.get("reason") else ""
        print(f"{h.get('device_id','?')}: {h.get('state','?')}{reason}")
    e=d.get("estimate")
    if isinstance(e,dict):
        yaw=e.get("yaw_rad")
        yaw=math.degrees(yaw) if isinstance(yaw,(int,float)) else None
        print(f"x:            {e.get('x_m','-')} m")
        print(f"y:            {e.get('y_m','-')} m")
        print(f"yaw:          {yaw:.2f} deg" if yaw is not None else "yaw:          -")
        print(f"v:            {e.get('v_mps','-')} m/s")
        print(f"omega:        {e.get('omega_rad_s','-')} rad/s")
else:
    r=d.get("report") or {}
    print(f"Exit reason:  {r.get('exit_reason','-')}")
    print(f"Lifecycle:    {r.get('final_lifecycle','-')}")
    print(f"Safety:       {r.get('final_safety_decision','-')} / {r.get('final_reason','-')}")
    print(f"Fault layer:  {r.get('fault_layer') or '-'}")
    print(f"Termination:  {r.get('termination_class','-')}")
    if d.get("error"):
        print(f"Error:        {d.get('error_type','ERROR')}: {d.get('error')}")
PY

    [[ "$s" != *'"state": "RUNNING"'* && -s "$RUNTIME_LOG" ]] && {
        echo
        echo "Last runtime log:"
        tail -n 20 "$RUNTIME_LOG"
    }
}

_new_capture_path() {
    echo "$CAPTURE_DIR/v3_$(date '+%Y%m%d_%H%M%S')_$$_capture.json"
}

_current_capture() {
    [[ -r "$CAPTURE_PATH_FILE" ]] && cat "$CAPTURE_PATH_FILE"
}

_capture_used() {
    [[ -e "$CAPTURE_USED_FILE" ]] && return 0
    local p=""
    p="$(_current_capture)"
    [[ -n "$p" && -f "$p" ]]
}

# The detached shell only waits for the native process and runs offline tools.
# It owns no robot-control path. Its capture argument belongs to this session,
# so a later restart cannot redirect validation to another session's file.
_runtime_session() {
    local capture="$1" pid output result
    python3 v3_process_runtime.py \
        --approval native-resident-v3 \
        --capture-path "${capture#"$ROOT"/}" \
        --capture-mode triggered &
    pid=$!
    echo "$pid" >"$RUNTIME_PID_FILE"
    chmod 600 "$RUNTIME_PID_FILE" 2>/dev/null || true
    trap 'kill -TERM "$pid" 2>/dev/null || true' INT TERM
    wait "$pid"
    # A signal can interrupt wait before the native shutdown/finalizer finishes.
    while _pid_has_arg "$pid" "v3_process_runtime.py"; do wait "$pid"; done
    trap '' INT TERM
    if [[ -f "$capture" ]]; then
        output="$(mktemp -d /tmp/r2b4-test-hub.XXXXXXXX)" || return 1
        echo "test hub: validating $capture -> $output"
        python3 -m v3.test_hub validate "$capture" \
            --project-root "$ROOT" --output-dir "$output"
        result=$?
        echo "test hub: finished (exit $result), results: $output"
        return "$result"
    fi
    echo "test hub: no new capture finalized for this runtime session"
}

_runtime_start() {
    local old="" fresh status_baseline="" pid="" supervisor i
    old="$(_runtime_pid 2>/dev/null || true)"

    if [[ -n "$old" ]]; then
        echo "runtime: existing instance -> STOP"
        _runtime_stop || return 1
        echo "runtime: waiting 5 s"
        sleep 5
        if _pid_has_arg "$old" "v3_process_runtime.py"; then
            echo "ERROR: old runtime still running (PID $old). New runtime not started." >&2
            return 1
        fi
        rm -f "$RUNTIME_PID_FILE"
    else
        _stop_heartbeat || return 1
    fi

    # A missing mailbox is canonical STOP. An empty/malformed JSON file faults
    # the gateway; remove the stale command only after the old writers exit.
    rm -f -- "$COMMAND_FILE" || return 1
    status_baseline="$(_status_json 2>/dev/null || true)"

    fresh="$(_new_capture_path)"
    echo "$fresh" >"$CAPTURE_PATH_FILE"
    chmod 600 "$CAPTURE_PATH_FILE" 2>/dev/null || true
    rm -f "$CAPTURE_USED_FILE" "$MOVEMENT_CAPTURE_FILE"

    RUNTIME_LOG="$(mktemp /tmp/r2b4-runtime.XXXXXXXX.log)" || return 1
    echo "$RUNTIME_LOG" >"$RUNTIME_DIR/.r2b4_runtime_log"
    rm -f "$RUNTIME_PID_FILE"
    nohup bash "$ROOT/r2b4" __runtime-session "$fresh" \
        </dev/null >"$RUNTIME_LOG" 2>&1 &
    supervisor=$!
    for i in {1..40}; do
        [[ -r "$RUNTIME_PID_FILE" ]] && read -r pid <"$RUNTIME_PID_FILE"
        [[ -n "$pid" ]] && break
        kill -0 "$supervisor" 2>/dev/null || break
        sleep 0.05
    done

    sleep 0.20
    if ! _pid_has_arg "$pid" "v3_process_runtime.py"; then
        rm -f "$RUNTIME_PID_FILE"
        echo "ERROR: runtime failed to start." >&2
        [[ -s "$RUNTIME_LOG" ]] && tail -n 30 "$RUNTIME_LOG" >&2
        return 1
    fi
    if ! _wait_fresh_ready "$pid" "$status_baseline"; then
        echo "ERROR: runtime did not publish a fresh ready status." >&2
        _show_diag >&2
        _runtime_stop || true
        return 1
    fi

    echo "runtime: STARTED (PID $pid)"
    echo "capture: ARMED (bounded ring)"
    echo "capture file: ${fresh#"$ROOT"/}"
    echo "runtime / Test Hub log: $RUNTIME_LOG"
    [[ "${R2B4_CTRL_C_HOOK:-0}" != "1" ]] && \
        echo "note: global Ctrl+C panic hook inactive; source $ROOT/r2b4"
    return 0
}

_runtime_stop() {
    local pid="" i result=0
    _robot_stop || result=1
    pid="$(_runtime_pid 2>/dev/null || true)"
    if [[ -z "$pid" ]]; then
        echo "runtime: already STOPPED"
        return "$result"
    fi
    kill -TERM "$pid" 2>/dev/null || true
    for i in {1..200}; do
        if ! _pid_has_arg "$pid" "v3_process_runtime.py"; then
            rm -f "$RUNTIME_PID_FILE"
            echo "runtime: STOPPED (PID $pid)"
            echo "test hub: automatic validation after finalization; log: $RUNTIME_LOG"
            return "$result"
        fi
        sleep 0.05
    done
    echo "ERROR: runtime did not exit after shutdown (PID $pid)." >&2
    return 1
}

_ensure_runtime() {
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] && return 0
    _runtime_start
}

_wait_idle() {
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 0
    python3 - "$STATUS_FILE" "$COMMAND_FILE" <<'PY'
import json, sys, time
from pathlib import Path
from v3.control_cli import _read_status
command = json.loads(Path(sys.argv[2]).read_text())
if command.get("mode") != "STOP":
    raise SystemExit("ERROR: another command replaced STOP before IDLE confirmation.")
issued_ns = command["issued_monotonic_ns"]
deadline = time.monotonic() + 3.0
while time.monotonic() < deadline:
    try:
        s = _read_status(Path(sys.argv[1]))
        age = time.monotonic_ns() - s.get("monotonic_ns", 0)
        if (s.get("state") == "RUNNING" and 0 <= age < 500_000_000
                and s.get("monotonic_ns", 0) > issued_ns
                and s.get("ready_for_active") is True
                and s.get("safety_decision") == "STOP"
                and s.get("enabled") is False
                and s.get("left_output") == s.get("right_output") == 0):
            raise SystemExit(0)
        if s.get("state") != "RUNNING" or s.get("fault_layer") or s.get("safety_decision") == "FAULT":
            break
    except ValueError:
        break
    time.sleep(0.05)
print("ERROR: runtime did not confirm ready IDLE with inactive outputs.", file=sys.stderr)
raise SystemExit(1)
PY
}

_wait_ready() {
    local i
    for i in {1..160}; do
        [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 1
        _status_ready && return 0
        sleep 0.05
    done
    return 1
}

_wait_fresh_ready() {
    local pid="$1" baseline="$2" s="" i
    for i in {1..160}; do
        _pid_has_arg "$pid" "v3_process_runtime.py" || return 1
        s="$(_status_json)" || { sleep 0.05; continue; }
        if [[ "$s" != "$baseline" &&
              "$s" == *'"state": "RUNNING"'* &&
              "$s" == *'"ready_for_active": true'* ]]; then
            return 0
        fi
        sleep 0.05
    done
    return 1
}

_ensure_fresh_capture_slot() {
    if ! _capture_used; then
        return 0
    fi

    echo "capture: previous slot used -> re-arm requires runtime restart"
    _runtime_start || return 1
    _wait_ready || {
        echo "ERROR: restarted runtime not ready." >&2
        _show_diag >&2
        return 1
    }
}

_trigger_current_capture() {
    local origin="$1" pid="" path=""
    pid="$(_runtime_pid 2>/dev/null || true)"
    [[ -n "$pid" ]] || { echo "ERROR: runtime is not running." >&2; return 1; }

    path="$(_current_capture)"
    [[ -n "$path" ]] || { echo "ERROR: no launcher-managed capture path." >&2; return 1; }

    # If the file/launcher marker already exists, the native one-shot worker
    # has already been used. Do not pretend a second trigger is possible.
    _capture_used && return 0

    kill -USR1 "$pid" 2>/dev/null || { echo "ERROR: capture trigger failed." >&2; return 1; }
    printf 'origin=%s\ntriggered_at_ns=%s\n' "$origin" "$(date +%s%N)" >"$CAPTURE_USED_FILE"
    chmod 600 "$CAPTURE_USED_FILE" 2>/dev/null || true

    echo "capture: TRIGGERED ($origin)"
    echo "capture file: ${path#"$ROOT"/}"
}

_trigger_capture() {
    local origin="$1"
    _ensure_runtime || return 1
    _ensure_fresh_capture_slot || return 1
    _trigger_current_capture "$origin"
}

_trigger_movement_capture_if_needed() {
    [[ -e "$MOVEMENT_CAPTURE_FILE" ]] || return 0
    _capture_used && return 0
    [[ -n "$(_runtime_pid 2>/dev/null || true)" ]] || return 0
    _trigger_current_capture "movement-stop"
}

_capture_status() {
    local path=""
    path="$(_current_capture)"
    [[ -n "$path" ]] || { echo "capture: NOT ARMED"; return; }

    if [[ -f "$path" ]]; then
        CAPTURE_FILE="$path" python3 - <<'PY'
import json, os
from pathlib import Path
p=Path(os.environ["CAPTURE_FILE"])
d=json.loads(p.read_text(encoding="utf-8"))
print("capture: FINALIZED")
print(f"file:    {p}")
print(f"status:  {d.get('status','-')}")
print(f"ticks:   {d.get('tick_count','-')}")
w=d.get("capture_window") or {}
i=d.get("capture_integrity") or {}
print(f"trigger: {w.get('trigger_reason','-')}")
print(f"complete:{' YES' if i.get('complete') is True else ' NO'}")
PY
    elif [[ -e "$CAPTURE_USED_FILE" ]]; then
        echo "capture: TRIGGERED / finalizing"
        echo "file:    ${path#"$ROOT"/}"
    elif [[ -e "$MOVEMENT_CAPTURE_FILE" ]]; then
        echo "capture: ARMED for movement (will save on STOP/FAULT)"
        echo "file:    ${path#"$ROOT"/}"
    else
        echo "capture: ARMED"
        echo "file:    ${path#"$ROOT"/}"
    fi
}

_capture_stop() {
    local path="" i
    path="$(_current_capture)"
    [[ -n "$path" ]] || { echo "capture: NOT ARMED"; return 1; }

    if [[ -e "$MOVEMENT_CAPTURE_FILE" && ! -e "$CAPTURE_USED_FILE" && ! -f "$path" ]]; then
        _trigger_current_capture "capture-stop" || return 1
    fi

    if [[ ! -e "$CAPTURE_USED_FILE" && ! -f "$path" ]]; then
        echo "capture: no triggered capture"
        return
    fi
    for i in {1..70}; do
        [[ -f "$path" ]] && break
        sleep 0.05
    done
    if [[ -f "$path" ]]; then
        _capture_status
    else
        echo "capture: still finalizing"
        echo "file:    ${path#"$ROOT"/}"
    fi
}

_valid_speed() {
    python3 - "$1" <<'PY'
import math, sys
try: v=float(sys.argv[1])
except ValueError: raise SystemExit(1)
raise SystemExit(0 if math.isfinite(v) and 0.0 < v <= 0.50 else 1)
PY
}

_failure_report() {
    local label="$1"
    local saved="${2:-}"
    local s="$saved"
    echo "ERROR: $label did not reach motor ALLOW." >&2
    [[ -z "$s" ]] && s="$(_status_json)" || true
    if [[ -n "$s" ]]; then
        echo >&2
        STATUS_JSON="$s" python3 - <<'PY' >&2
import json, os
d=json.loads(os.environ["STATUS_JSON"])
print(f"state:       {d.get('state','-')}")
print(f"tick:        {d.get('tick_id','-')}")
print(f"fault layer: {d.get('fault_layer') or '-'}")
print(f"safety:      {d.get('safety_decision','-')} / {d.get('safety_reason','-')}")
print(f"motors:      {d.get('left_output','-')} / {d.get('right_output','-')}")
r=d.get("report") or {}
if r:
    print(f"final:       {r.get('final_safety_decision','-')} / {r.get('final_reason','-')}")
    print(f"termination: {r.get('termination_class','-')}")
PY
    fi
    [[ -s "$COMMAND_LOG" ]] && { echo >&2; echo "Command log:" >&2; tail -n 20 "$COMMAND_LOG" >&2; }
    [[ -s "$RUNTIME_LOG" ]] && { echo >&2; echo "Runtime log:" >&2; tail -n 20 "$RUNTIME_LOG" >&2; }
}

_wait_allow() {
    local cpid="$1" baseline="$2" label="$3" s="" tick i
    for i in {1..50}; do
        if ! _pid_has_arg "$cpid" "v3.control_cli"; then
            _failure_report "$label" "$s"
            return 1
        fi
        if [[ -z "$(_runtime_pid 2>/dev/null || true)" ]]; then
            _stop_heartbeat || true
            _failure_report "$label"
            return 1
        fi

        s="$(_status_json)" || { sleep 0.05; continue; }
        tick="$(_tick_from_json "$s")"
        if (( tick > baseline )); then
            if _status_is_fault "$s"; then
                local bad="$s"
                _trigger_movement_capture_if_needed || true
                _stop_heartbeat || true
                _publish_stop || true
                rm -f "$MOVEMENT_CAPTURE_FILE"
                _failure_report "$label" "$bad"
                return 1
            fi
            _status_has_real_allow "$s" && return 0
        fi
        sleep 0.05
    done

    local last="$s"
    _trigger_movement_capture_if_needed || true
    _stop_heartbeat || true
    _publish_stop || true
    rm -f "$MOVEMENT_CAPTURE_FILE"
    _failure_report "$label" "$last"
    return 1
}

_start_motion() {
    local label="$1" capture="$2"
    shift 2
    local s="" baseline="-1" cpid

    _ensure_runtime || return 1

    _robot_stop || return 1
    _wait_idle || { _show_diag >&2; return 1; }

    if [[ "$capture" == "yes" ]]; then
        _ensure_fresh_capture_slot || return 1
        _wait_ready || { echo "ERROR: runtime not ready after capture re-arm." >&2; return 1; }
        echo "movement" >"$MOVEMENT_CAPTURE_FILE"
        chmod 600 "$MOVEMENT_CAPTURE_FILE" 2>/dev/null || true
    else
        rm -f "$MOVEMENT_CAPTURE_FILE"
    fi

    s="$(_status_json)" || true
    [[ -n "$s" ]] && baseline="$(_tick_from_json "$s")"

    COMMAND_LOG="$(mktemp /tmp/r2b4-command.XXXXXXXX.log)" || return 1
    echo "$COMMAND_LOG" >"$RUNTIME_DIR/.r2b4_command_log"
    nohup "$@" </dev/null >"$COMMAND_LOG" 2>&1 &
    cpid=$!
    echo "$cpid" >"$COMMAND_PID_FILE"
    chmod 600 "$COMMAND_PID_FILE" 2>/dev/null || true

    _wait_allow "$cpid" "$baseline" "$label" || return 1

    echo "$label: STARTED"
    echo "motor: ALLOW confirmed"
    if [[ "$capture" == "yes" ]]; then
        local p="$(_current_capture)"
        echo "capture: ARMED for STOP/FAULT -> ${p#"$ROOT"/}"
    else
        echo "capture: skipped by nocapture"
    fi
}

_forward() {
    local speed="0.15" speed_set="no" capture="yes" a
    shift 2
    for a in "$@"; do
        if [[ "$a" == "nocapture" ]]; then
            capture="no"
        elif [[ "$speed_set" == "no" ]]; then
            speed="$a"; speed_set="yes"
        else
            echo "ERROR: invalid forward arguments." >&2; return 2
        fi
    done
    _valid_speed "$speed" || { echo "ERROR: speed must be >0 and <=0.50 m/s." >&2; return 1; }

    _start_motion "forward $speed m/s" "$capture" \
        python3 -m v3.control_cli teleop \
        --command-id "launcher-forward-$(date +%s%N)-$$" \
        --v-mps "$speed" --omega-rad-s 0 \
        --max-v-mps "$speed" --max-omega-rad-s 0.60
}

_wheel_targets_to_twist() {
    python3 - "$ROOT/conf/fizika.json" "$1" "$2" <<'PY'
import json
import math
import sys
from pathlib import Path

physics_path = Path(sys.argv[1])
try:
    left_mps = float(sys.argv[2])
    right_mps = float(sys.argv[3])
except ValueError:
    print("ERROR: left_mps and right_mps must be numeric.", file=sys.stderr)
    raise SystemExit(1)

if not math.isfinite(left_mps) or not math.isfinite(right_mps):
    print("ERROR: wheel speeds must be finite.", file=sys.stderr)
    raise SystemExit(1)
if abs(left_mps) > 0.50 or abs(right_mps) > 0.50:
    print("ERROR: each wheel speed must be within [-0.50, 0.50] m/s.", file=sys.stderr)
    raise SystemExit(1)
if abs(left_mps) <= 1e-12 and abs(right_mps) <= 1e-12:
    print("ERROR: both wheel targets are zero; use ./r2b4 stop.", file=sys.stderr)
    raise SystemExit(1)

try:
    physics = json.loads(physics_path.read_text(encoding="utf-8"))
    track_width_m = float(physics["nyomtav_szelesseg_m"])
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
    print(f"ERROR: cannot read valid track width from {physics_path}: {exc}", file=sys.stderr)
    raise SystemExit(1)
if not math.isfinite(track_width_m) or track_width_m <= 0.0:
    print("ERROR: nyomtav_szelesseg_m must be finite and positive.", file=sys.stderr)
    raise SystemExit(1)

# Exact inverse of V3 L10 differential-drive kinematics:
# left = v - omega * track/2
# right = v + omega * track/2
v_mps = 0.5 * (left_mps + right_mps)
omega_rad_s = (right_mps - left_mps) / track_width_m

# The resident command gateway is still the ingress authority. Reject only a
# target that it cannot represent at all; lower L5-L12 constraints may further
# reduce the executed motion and remain authoritative.
if abs(v_mps) > 0.50 + 1e-12:
    print(f"ERROR: wheel pair requires v={v_mps:.6f} m/s above the resident 0.50 m/s limit.", file=sys.stderr)
    raise SystemExit(1)
if abs(omega_rad_s) > 1.20 + 1e-12:
    print(
        f"ERROR: wheel pair requires omega={omega_rad_s:.6f} rad/s "
        "above the resident 1.20 rad/s limit.",
        file=sys.stderr,
    )
    raise SystemExit(1)

# TELEOP declares positive limits even when one target component is exactly 0.
max_v_mps = max(abs(v_mps), 1e-6)
max_omega_rad_s = max(abs(omega_rad_s), 1e-6)
print(
    f"{v_mps:.12g} {omega_rad_s:.12g} "
    f"{max_v_mps:.12g} {max_omega_rad_s:.12g} {track_width_m:.12g}"
)
PY
}

_mozog() {
    local capture="yes" left right converted v omega max_v max_omega track
    shift 2
    [[ $# -ge 2 && $# -le 3 ]] || {
        echo "ERROR: usage: ./r2b4 mozog start <left_mps> <right_mps> [nocapture]" >&2
        return 2
    }
    left="$1"
    right="$2"
    if [[ $# -eq 3 ]]; then
        [[ "$3" == "nocapture" ]] || { echo "ERROR: unknown option: $3" >&2; return 2; }
        capture="no"
    fi

    converted="$(_wheel_targets_to_twist "$left" "$right")" || return 1
    read -r v omega max_v max_omega track <<<"$converted"

    echo "mozog wheel target: left=$left m/s, right=$right m/s"
    echo "canonical target: v=$v m/s, omega=$omega rad/s (track=$track m)"

    _start_motion "mozog L=$left R=$right m/s" "$capture" \
        python3 -m v3.control_cli teleop \
        --command-id "launcher-mozog-$(date +%s%N)-$$" \
        --v-mps "$v" --omega-rad-s "$omega" \
        --max-v-mps "$max_v" --max-omega-rad-s "$max_omega"
}

_roomcruise() {
    local capture="yes"
    shift 2
    [[ $# -le 1 ]] || { echo "ERROR: roomcruise accepts only optional nocapture." >&2; return 2; }
    if [[ $# -eq 1 ]]; then
        [[ "$1" == "nocapture" ]] || { echo "ERROR: unknown option: $1" >&2; return 2; }
        capture="no"
    fi
    _start_motion "roomcruise" "$capture" \
        python3 -m v3.control_cli explore \
        --command-id "launcher-roomcruise-$(date +%s%N)-$$"
}

_proba() {
    local cpid result
    _ensure_runtime || return 1
    _robot_stop || return 1
    _wait_idle || return 1
    _ensure_fresh_capture_slot || return 1
    echo "movement" >"$MOVEMENT_CAPTURE_FILE"
    chmod 600 "$MOVEMENT_CAPTURE_FILE" 2>/dev/null || true

    # One interruptible command producer owns the whole sequence, including
    # pauses. External STOP terminates it before publishing the final STOP.
    python3 - r2b4-proba "$ROOT" <<'PY' &
import json, math, os, signal, sys, time
from pathlib import Path
from v3.adapters.resident_command import ResidentCommandClient, ResidentCommandMailboxConfig
from v3.control_cli import _read_status

root = Path(sys.argv[2])
client = ResidentCommandClient(ResidentCommandMailboxConfig(path=root / "runtime/v3_command.json"))
status_path = root / "runtime/v3_status.json"
command_id = f"launcher-proba-{os.getpid()}-{time.monotonic_ns()}"
ttl_ns = 200_000_000

def interrupted(signum, frame):
    raise KeyboardInterrupt

signal.signal(signal.SIGINT, interrupted)
signal.signal(signal.SIGTERM, interrupted)

def status():
    s = _read_status(status_path)
    age = time.monotonic_ns() - s.get("monotonic_ns", 0)
    if (s.get("state") != "RUNNING" or not 0 <= age < 500_000_000
            or s.get("fault_layer") or s.get("safety_decision") == "FAULT"
            or any(h.get("state") != "OK" for h in s.get("source_health", []))):
        raise RuntimeError(f"runtime/health/timing failure: {s}")
    return s

def stopped(s):
    return (s.get("safety_decision") == "STOP" and s.get("enabled") is False
            and s.get("left_output") == s.get("right_output") == 0
            and s.get("ready_for_active") is True)

def stop():
    client.publish_stop(command_id + "-stop", ttl_ns=ttl_ns)

def idle(pause):
    issued_ns = time.monotonic_ns()
    stop()
    deadline = time.monotonic() + 3.0
    while True:
        s = status()
        if s["monotonic_ns"] > issued_ns and stopped(s):
            break
        if time.monotonic() >= deadline:
            raise RuntimeError("IDLE was not confirmed")
        time.sleep(0.05)
    deadline = time.monotonic() + pause
    while time.monotonic() < deadline:
        if not stopped(status()):
            raise RuntimeError("runtime left IDLE during pause")
        time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))

def yaw(s):
    value = (s.get("estimate") or {}).get("yaw_rad")
    if not isinstance(value, (int, float)) or not math.isfinite(value):
        raise RuntimeError("missing/invalid runtime yaw")
    return value

def phase(index, label, target, angle=0.0):
    print(f"proba {index}/10: {label}", flush=True)
    initial = status()
    if not stopped(initial):
        raise RuntimeError("phase requires ready IDLE")
    previous_yaw = yaw(initial) if angle else 0.0
    turned = 0.0
    started = time.monotonic()
    published_ns = time.monotonic_ns()
    allowed = False
    next_send = started
    while True:
        now = time.monotonic()
        elapsed = now - started
        s = status()
        if s["monotonic_ns"] > published_ns:
            if s.get("safety_decision") == "ALLOW" and s.get("enabled") is True:
                allowed = True
            elif allowed or s.get("safety_reason") != "NOT_ACTIVE":
                raise RuntimeError(f"motion stopped by safety: {s}")
        if not allowed and elapsed > 1.5:
            raise RuntimeError("phase did not reach ALLOW")
        if angle:
            current_yaw = yaw(s)
            turned += math.atan2(math.sin(current_yaw - previous_yaw), math.cos(current_yaw - previous_yaw))
            previous_yaw = current_yaw
            remaining = abs(angle) - math.copysign(1.0, angle) * turned
            if remaining <= math.radians(2):
                break
            if elapsed > 30.0:
                raise RuntimeError("turn did not reach its target within 30 s")
            # Slow down near the requested angle; wheel ratios stay unchanged.
            scale = min(1.0, max(0.15, remaining / math.radians(25)))
        else:
            if elapsed >= 5.0:
                break
            scale = 1.0
        if now - next_send > 0.08:
            raise RuntimeError("command heartbeat deadline missed")
        v, omega = target(min(1.0, elapsed / 4.9))
        client.publish_teleop(f"{command_id}-{index}", v_mps=v * scale,
                             omega_rad_s=omega * scale, max_v_mps=0.25,
                             max_omega_rad_s=0.60, ttl_ns=ttl_ns)
        next_send += 0.1
        time.sleep(max(0.0, next_send - time.monotonic()))
    idle(5.0 if index < 10 else 0.0)

try:
    track = float(json.loads((root / "conf/fizika.json").read_text())["nyomtav_szelesseg_m"])
    if not math.isfinite(track) or track <= 0:
        raise ValueError("invalid track width")
    phase(1, "előre, 5 s, 0.15–0.25 m/s", lambda t: (0.15 + 0.10 * t, 0.0))
    phase(2, "hátra, 5 s, 0.15–0.25 m/s", lambda t: (-0.15 - 0.10 * t, 0.0))
    # Right/left describes the side of the arc relative to the chassis;
    # reversing travel reverses yaw, just as for a wheel-speed pair.
    for index, label, direction, side in (
        (3, "jobbra előre", 1, -1), (4, "jobbra hátra", -1, -1),
        (5, "balra előre", 1, 1), (6, "balra hátra", -1, 1),
    ):
        phase(index, label + ", 5 s, R=2.0→0.6 m",
              lambda t: (direction * 0.15, side * direction * 0.15 / (2.0 - 1.4 * t)))
    phase(7, "helyben jobbra 90°", lambda t: (0.0, -0.4), -math.pi / 2)
    phase(8, "helyben balra 90°", lambda t: (0.0, 0.4), math.pi / 2)
    pivot_omega = min(0.4, 0.20 / track)
    phase(9, "jobbra 180°, jobb kerék célja 0", lambda t: (pivot_omega * track / 2, -pivot_omega), -math.pi)
    phase(10, "balra 180°, jobb kerék célja 0", lambda t: (-pivot_omega * track / 2, pivot_omega), math.pi)
    print("proba: kész, IDLE", flush=True)
except KeyboardInterrupt:
    print("proba: megszakítva", flush=True)
    raise SystemExit(130)
except Exception as exc:
    print(f"ERROR: proba aborted: {exc}", file=sys.stderr, flush=True)
    raise SystemExit(1)
finally:
    # Do not let a second interrupt prevent the final mailbox STOP.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    stop()
PY
    cpid=$!
    echo "$cpid" >"$COMMAND_PID_FILE"
    chmod 600 "$COMMAND_PID_FILE" 2>/dev/null || true
    wait "$cpid"
    result=$?
    # Only finish our own capture; a replacing command may already be running.
    if [[ "$(cat "$COMMAND_PID_FILE" 2>/dev/null)" == "$cpid" ]]; then
        _trigger_movement_capture_if_needed || true
        rm -f "$COMMAND_PID_FILE" "$MOVEMENT_CAPTURE_FILE"
    fi
    return "$result"
}

main() {
    case "${1:-} ${2:-}" in
        "runtime start")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _runtime_start
            ;;
        "runtime stop")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _runtime_stop
            ;;
        "runtime status")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _show_status
            ;;
        "runtime diag")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _show_diag
            ;;
        "capture start")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _trigger_capture "manual"
            ;;
        "capture stop")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _capture_stop
            ;;
        "capture status")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _capture_status
            ;;
        "forward start")
            _forward "$@"
            ;;
        "mozog start")
            _mozog "$@"
            ;;
        "roomcruise start")
            _roomcruise "$@"
            ;;
        "stop ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _robot_stop || return 1
            _wait_idle || return 1
            echo "robot: IDLE (runtime kept running if present)"
            ;;
        "shutdown ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _runtime_stop
            ;;
        "proba ")
            [[ $# -eq 1 ]] || { usage; return 2; }
            _proba
            ;;
        __runtime-session\ *)
            [[ $# -eq 2 ]] || return 2
            _runtime_session "$2"
            ;;
        "panic --quiet")
            _panic
            ;;
        "panic ")
            _panic
            echo "robot: STOP + runtime shutdown requested"
            ;;
        "help "|"--help "|"-h ")
            usage
            ;;
        *)
            usage
            return 2
            ;;
    esac
}

main "$@"
