{
  "schema": "R2B4_AGENT_INFRASTRUCTURE_V1",
  "contract_id": "R2B4_AGENT_INFRA_HARDENED_V3",
  "default_agent_mode": "single_agent",
  "max_auxiliary_agents": 1,
  "recursive_delegation_allowed": false,
  "parallel_writers_allowed": false,
  "context_budgets_bytes": {
    "cold_capsule": 4096,
    "unchanged_delta": 1024,
    "auxiliary_input": 6144,
    "auxiliary_output": 3072
  },
  "normative_authorities": {
    "v3_robot_architecture": {
      "authority": "NORMATIVE_SSOT",
      "path": "STRUKTURALIS_RETEGEK_V3.md",
      "document_role": "v3_robot_architecture",
      "contract_id": "R2B4_ARCH_LAYER_CONTRACT_V3",
      "domains": ["robot_v3", "robot_validation"]
    }
  },
  "universal_invariants": [
    "SOURCE_AND_ACTIVE_CONFIG_FIRST",
    "NO_SAFETY_PASS_OR_QUALITY_GATE_RELAXATION",
    "NO_GIT_RECOVERY_ASSUMPTION",
    "LIVE_MOTION_EXPLICIT_SCOPE_FAIL_CLOSED_IDLE"
  ],
  "domain_invariants": {
    "robot_v3": [
      "V3_ONE_TICK_ONE_INPUT_SNAPSHOT_ONE_DECISION_ONE_COMMIT",
      "V3_L12_ONLY_NORMAL_MOTOR_WRITER",
      "V3_FAIL_CLOSED_STOP",
      "V3_NO_LEGACY_SHARED_STATE_OR_AUTHORITY",
      "V3_REPLAYABLE_DECISIONS_REQUIRED"
    ],
    "robot_validation": [
      "V3_REPLAYER_OFFLINE_NO_HARDWARE_AUTHORITY",
      "V3_CAPTURE_REPLAY_LIVE_AUTHORITY_SEPARATION",
      "V3_INPUT_SOURCE_PRODUCTION_OUTPUT_SINK_BOUNDARY",
      "V3_RUN_SCOPED_EVIDENCE"
    ]
  },
  "workflow": {
    "source_order": ["SOURCE", "ACTIVE_CONFIG", "CANONICAL_CONTRACT"],
    "diagnostics": {
      "primary": "REPLAYER_V3",
      "sequence": ["INSPECT", "REPLAY", "VERIFY_RESULT", "DIAGNOSIS"],
      "source_routes": [
        "STRUKTURALIS_RETEGEK_V3.md",
        "v3/execution.py",
        "v3/capture.py",
        "v3/replay.py",
        "v3/test_hub.py"
      ],
      "domain_profiles": {}
    },
    "testing": {
      "order": ["TARGETED", "REPLAY", "FULL_REGRESSION_IF_JUSTIFIED"],
      "default": "TARGETED",
      "legacy_contract_conflict_authority": "NON_AUTHORITY",
      "full_regression_reasons": [
        "SHARED_CONTRACT_CHANGE",
        "AGENT_INFRASTRUCTURE_OR_BOOTSTRAP_CHANGE",
        "TEST_INFRASTRUCTURE_CHANGE",
        "EXPLICIT_USER_REQUEST",
        "DIAGNOSTIC_INVESTIGATION"
      ],
      "full_regression_required_paths": [
        "AGENTS.md",
        "docs/AGENT_RUNTIME.md",
        "project_rules/agent_infrastructure.json",
        "project_rules/agent_system_prompt.txt",
        "project_rules/bootstrap_guard.py",
        "scripts/bootstrap_guard.sh",
        "tests/test_agent_change_tracker.py",
        "tests/test_agent_workspace.py",
        "tests/test_agentctl.py",
        "tests/test_bootstrap_guard.py",
        "tools/agent_change_tracker.py",
        "tools/agent_workspace.py",
        "tools/agentctl.py"
      ]
    }
  },
  "leases": {
    "workspace_write": {"exclusive": true, "default_ttl_s": 7200},
    "canonical_promotion": {"exclusive": true, "default_ttl_s": 1800},
    "runtime_control": {"exclusive": true, "default_ttl_s": 900},
    "live_motion": {"exclusive": true, "default_ttl_s": 3600},
    "latest_artifact_publish": {"exclusive": true, "default_ttl_s": 900},
    "full_pytest": {"exclusive": true, "default_ttl_s": 3600}
  },
  "task_workspace": {
    "enabled": true,
    "root": "runtime/agent_workspaces",
    "protected_store": "/var/lib/r2b4-agent",
    "privileged_operations": true,
    "exclude_top_level": [
      ".agents",
      ".cursor",
      ".git",
      ".pytest_cache",
      ".vscode",
      "Pic",
      "__pycache__",
      "log_ARCHIVE",
      "logs",
      "project_r2b4.ol2",
      "replayer_data",
      "runtime",
      "save"
    ],
    "exclude_names": ["__pycache__", ".pytest_cache", ".lgd-nfy0"],
    "exclude_paths": [
      ".env.local",
      ".lgd-nfy0",
      ".r2b4_candidate.json",
      "controller.log",
      "log/run/",
      "os.log",
      "project_rules/current_change.json"
    ],
    "protected_infrastructure_paths": [
      "AGENTS.md",
      "docs/AGENT_RUNTIME.md",
      "project_rules/agent_infrastructure.json",
      "project_rules/agent_system_prompt.txt",
      "project_rules/bootstrap_guard.py",
      "scripts/bootstrap_guard.sh",
      "tests/test_agent_change_tracker.py",
      "tests/test_agent_workspace.py",
      "tests/test_agentctl.py",
      "tests/test_bootstrap_guard.py",
      "tools/agent_change_tracker.py",
      "tools/agent_workspace.py",
      "tools/agentctl.py"
    ],
    "change_mode": "CHANGE"
  },
  "auxiliary_agent_policy": {
    "default": "NONE",
    "allowed_roles": ["independent_reviewer", "root_cause_analyst"],
    "activation": {
      "independent_reviewer": {
        "requires_any_path": [
          "AGENTS.md",
          "docs/AGENT_RUNTIME.md",
          "project_rules/agent_infrastructure.json",
          "project_rules/bootstrap_guard.py",
          "tools/agent_change_tracker.py",
          "tools/agent_workspace.py",
          "tools/agentctl.py"
        ],
        "evidence": "agent_infrastructure_contract_change"
      },
      "root_cause_analyst": {
        "requires_immutable_incident": true,
        "requires_repeated_failure_count": 2,
        "requires_machine_failure_signature": true,
        "evidence": "same_failure_signature_in_distinct_runs"
      }
    }
  },
  "domains": {
    "agent_infrastructure": {
      "paths": [
        "AGENTS.md",
        "docs/AGENT_RUNTIME.md",
        "project_rules/agent_infrastructure.json",
        "project_rules/agent_system_prompt.txt",
        "project_rules/bootstrap_guard.py",
        "scripts/bootstrap_guard.sh",
        "tools/agent_change_tracker.py",
        "tools/agent_workspace.py",
        "tools/agentctl.py"
      ],
      "sources": [
        "AGENTS.md",
        "docs/AGENT_RUNTIME.md",
        "project_rules/agent_infrastructure.json",
        "tests/test_agent_change_tracker.py",
        "tests/test_agent_workspace.py",
        "tests/test_agentctl.py",
        "tests/test_bootstrap_guard.py"
      ]
    },
    "robot_v3": {
      "paths": [
        "STRUKTURALIS_RETEGEK_V3.md",
        "v3/",
        "v3_bounded_config.py",
        "v3_bounded_runtime.py",
        "v3_process_runtime.py"
      ],
      "sources": [
        "STRUKTURALIS_RETEGEK_V3.md",
        "conf/hardver.json",
        "conf/fizika.json",
        "conf/speed_map.json"
      ],
      "required_authority": "v3_robot_architecture"
    },
    "robot_validation": {
      "paths": [
        "v3/execution.py",
        "v3/capture.py",
        "v3/replay.py",
        "v3/test_hub.py"
      ],
      "sources": [
        "STRUKTURALIS_RETEGEK_V3.md",
        "v3/execution.py",
        "v3/capture.py",
        "v3/replay.py",
        "v3/test_hub.py"
      ],
      "required_authority": "v3_robot_architecture"
    }
  }
}
