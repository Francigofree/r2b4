#!/usr/bin/env bash
# R2B4 user launcher.
#
# Normal use:
#   ./r2b4 runtime start
#   ./r2b4 runtime status
#   ./r2b4 runtime diag
#   ./r2b4 forward start
#   ./r2b4 roomcruise start
#   ./r2b4 stop
#
# Optional global Ctrl+C panic hook for the interactive shell:
#   source /home/alba/project_r2b4/r2b4
#
# After sourcing, Ctrl+C at the shell prompt also stops active commands
# and requests canonical runtime shutdown.

_R2B4_SOURCE="${BASH_SOURCE[0]}"
_R2B4_ROOT="$(cd "$(dirname "$_R2B4_SOURCE")" && pwd)"

# When sourced, install only the interactive Ctrl+C hook.
if [[ "$_R2B4_SOURCE" != "$0" ]]; then
    export R2B4_CTRL_C_HOOK=1
    _r2b4_ctrl_c_panic() {
        printf '\nR2B4: Ctrl+C -> STOP + runtime shutdown\n' >&2
        "$_R2B4_ROOT/r2b4" panic --quiet >/dev/null 2>&1 || true
    }
    trap '_r2b4_ctrl_c_panic' INT
    return 0
fi

set -u

ROOT="$_R2B4_ROOT"
RUNTIME_DIR="$ROOT/runtime"
RUNTIME_LOG="/tmp/r2b4-runtime-current.log"
COMMAND_LOG="/tmp/r2b4-command-current.log"

cd "$ROOT" || exit 1
mkdir -p "$RUNTIME_DIR"

usage() {
    cat <<'EOF'
Usage:
  r2b4 runtime start
  r2b4 runtime stop
  r2b4 runtime status
  r2b4 runtime diag
  r2b4 forward start [speed_mps]
  r2b4 roomcruise start
  r2b4 stop

Defaults:
  forward speed = 0.15 m/s

Ctrl+C panic at the returned shell prompt:
  source /home/alba/project_r2b4/r2b4
EOF
}

_project_pids() {
    local marker="$1"
    local proc pid cwd cmd
    for proc in /proc/[0-9]*; do
        [[ -r "$proc/cmdline" ]] || continue
        cwd="$(readlink -f "$proc/cwd" 2>/dev/null || true)"
        [[ "$cwd" == "$ROOT" ]] || continue
        cmd="$(tr '\0' ' ' <"$proc/cmdline" 2>/dev/null || true)"
        [[ "$cmd" == *"$marker"* ]] || continue
        pid="${proc##*/}"
        printf '%s\n' "$pid"
    done
}

_runtime_pids() {
    _project_pids "v3_process_runtime.py"
}

_active_command_pids() {
    local pid proc cmd
    while IFS= read -r pid; do
        [[ -n "$pid" ]] || continue
        proc="/proc/$pid"
        cmd="$(tr '\0' ' ' <"$proc/cmdline" 2>/dev/null || true)"
        if [[ "$cmd" == *" teleop "* || "$cmd" == *" explore "* ]]; then
            printf '%s\n' "$pid"
        fi
    done < <(_project_pids "v3.control_cli")
}

_kill_pids() {
    local pid
    for pid in "$@"; do
        [[ -n "$pid" ]] || continue
        kill -TERM "$pid" 2>/dev/null || true
    done
}

_stop_active_heartbeat() {
    local pids=()
    local survivors=()
    local pid
    local attempt

    mapfile -t pids < <(_active_command_pids)
    if ((${#pids[@]} == 0)); then
        return 0
    fi

    _kill_pids "${pids[@]}"

    # Do not publish STOP while an old heartbeat process may still overwrite it.
    for attempt in {1..10}; do
        survivors=()
        for pid in "${pids[@]}"; do
            kill -0 "$pid" 2>/dev/null && survivors+=("$pid")
        done
        ((${#survivors[@]} == 0)) && return 0
        sleep 0.05
    done

    echo "ERROR: active command heartbeat did not stop (PID ${survivors[*]})." >&2
    return 1
}

_publish_stop() {
    python3 -m v3.control_cli stop \
        --command-id "launcher-stop-$(date +%s%N)-$$" \
        >/dev/null 2>&1
}

_robot_stop() {
    # Order matters: heartbeat must be gone before STOP is published.
    if ! _stop_active_heartbeat; then
        return 1
    fi
    _publish_stop || true
}

_runtime_stop_now() {
    local pids=()
    mapfile -t pids < <(_runtime_pids)
    if ((${#pids[@]})); then
        _kill_pids "${pids[@]}"
    fi
}

_panic() {
    _robot_stop || true
    _runtime_stop_now
}

_on_interrupt() {
    _panic
    exit 130
}
trap '_on_interrupt' INT

_status_json() {
    python3 -m v3.control_cli status 2>/dev/null
}

_status_ready() {
    local payload
    payload="$(_status_json)" || return 1
    STATUS_JSON="$payload" python3 - <<'PY'
import json, os, sys
data = json.loads(os.environ["STATUS_JSON"])
sys.exit(0 if data.get("state") == "RUNNING" and data.get("ready_for_active") is True else 1)
PY
}

_print_status() {
    local pids=()
    local payload=""
    mapfile -t pids < <(_runtime_pids)

    if ((${#pids[@]} == 0)); then
        echo "runtime: STOPPED"
        return 0
    fi

    payload="$(_status_json)" || {
        echo "runtime: RUNNING"
        echo "pid:     ${pids[*]}"
        echo "status:  unavailable/booting"
        return 0
    }

    STATUS_JSON="$payload" RUNTIME_PIDS="${pids[*]}" python3 - <<'PY'
import json, os
d = json.loads(os.environ["STATUS_JSON"])
print(f"runtime: {d.get('state', 'UNKNOWN')}")
print(f"pid:     {os.environ.get('RUNTIME_PIDS', '')}")
ready = d.get("ready_for_active")
print(f"ready:   {'YES' if ready is True else 'NO' if ready is False else '-'}")
if d.get("tick_id") is not None:
    print(f"tick:    {d['tick_id']}")
if d.get("safety_decision") is not None:
    print(f"safety:  {d.get('safety_decision')} / {d.get('safety_reason')}")
PY
}

_print_diag() {
    local pids=()
    local payload=""
    mapfile -t pids < <(_runtime_pids)

    if ((${#pids[@]} == 0)); then
        echo "R2B4 runtime: STOPPED"
        return 0
    fi

    payload="$(_status_json)" || {
        echo "R2B4 runtime: RUNNING"
        echo "PID: ${pids[*]}"
        echo "Status: unavailable/booting"
        return 1
    }

    STATUS_JSON="$payload" RUNTIME_PIDS="${pids[*]}" python3 - <<'PY'
import json, math, os
d = json.loads(os.environ["STATUS_JSON"])

print(f"R2B4 runtime: {d.get('state', 'UNKNOWN')}")
print(f"PID:          {os.environ.get('RUNTIME_PIDS', '')}")
ready = d.get("ready_for_active")
print(f"Ready:        {'YES' if ready is True else 'NO' if ready is False else '-'}")
print(f"Tick:         {d.get('tick_id', '-')}")
print(f"Fault layer:  {d.get('fault_layer') or '-'}")
print(f"Safety:       {d.get('safety_decision', '-')} / {d.get('safety_reason', '-')}")
print(f"Motors:       {d.get('left_output', '-')} / {d.get('right_output', '-')}")

health = d.get("source_health") or []
if health:
    print("")
    for item in health:
        device = item.get("device_id", "?")
        state = item.get("state", "?")
        reason = item.get("reason")
        suffix = f" ({reason})" if reason else ""
        print(f"{device}: {state}{suffix}")

est = d.get("estimate")
if isinstance(est, dict):
    print("")
    yaw = est.get("yaw_rad")
    yaw_deg = math.degrees(yaw) if isinstance(yaw, (int, float)) else None
    print(f"x:            {est.get('x_m', '-')} m")
    print(f"y:            {est.get('y_m', '-')} m")
    print(f"yaw:          {yaw_deg:.2f} deg" if yaw_deg is not None else "yaw:          -")
    print(f"v:            {est.get('v_mps', '-')} m/s")
    print(f"omega:        {est.get('omega_rad_s', '-')} rad/s")
PY
}

_start_runtime() {
    local old=()
    local left=()
    local pid

    mapfile -t old < <(_runtime_pids)
    if ((${#old[@]})); then
        echo "runtime: existing instance -> STOP"
        _robot_stop
        _kill_pids "${old[@]}"
        echo "runtime: waiting 5 s"
        sleep 5

        mapfile -t left < <(_runtime_pids)
        if ((${#left[@]})); then
            echo "ERROR: old runtime still running (PID ${left[*]}). New runtime not started." >&2
            return 1
        fi
    else
        _stop_active_heartbeat
    fi

    : >"$RUNTIME_LOG"
    nohup python3 v3_process_runtime.py \
        --approval native-resident-v3 \
        </dev/null >"$RUNTIME_LOG" 2>&1 &
    pid=$!

    sleep 0.15
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "ERROR: runtime failed to start." >&2
        [[ -s "$RUNTIME_LOG" ]] && tail -n 20 "$RUNTIME_LOG" >&2
        return 1
    fi

    echo "runtime: STARTED (PID $pid)"
    if [[ "${R2B4_CTRL_C_HOOK:-0}" != "1" ]]; then
        echo "note: global Ctrl+C panic hook is not active; see: source $ROOT/r2b4"
    fi
}

_stop_runtime() {
    local pids=()
    _robot_stop
    mapfile -t pids < <(_runtime_pids)
    if ((${#pids[@]} == 0)); then
        echo "runtime: already STOPPED"
        return 0
    fi
    _kill_pids "${pids[@]}"
    echo "runtime: shutdown requested (PID ${pids[*]})"
}

_validate_speed() {
    python3 - "$1" <<'PY'
import math, sys
try:
    v = float(sys.argv[1])
except ValueError:
    raise SystemExit(1)
raise SystemExit(0 if math.isfinite(v) and 0.0 < v <= 0.50 else 1)
PY
}

_start_active() {
    local mode="$1"
    shift
    local pid

    if [[ -z "$(_runtime_pids)" ]]; then
        echo "ERROR: runtime is not running." >&2
        return 1
    fi
    if ! _status_ready; then
        echo "ERROR: runtime is not ready for ACTIVE command." >&2
        return 1
    fi

    if ! _robot_stop; then
        echo "ERROR: previous active command could not be closed." >&2
        return 1
    fi

    : >"$COMMAND_LOG"
    nohup "$@" </dev/null >"$COMMAND_LOG" 2>&1 &
    pid=$!

    sleep 0.15
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "ERROR: command was rejected." >&2
        [[ -s "$COMMAND_LOG" ]] && tail -n 20 "$COMMAND_LOG" >&2
        return 1
    fi

    echo "$mode: STARTED (PID $pid)"
}

_forward_start() {
    local speed="${1:-0.15}"
    if ! _validate_speed "$speed"; then
        echo "ERROR: forward speed must be > 0 and <= 0.50 m/s." >&2
        return 1
    fi

    _start_active "forward ${speed} m/s" \
        python3 -m v3.control_cli teleop \
        --command-id "launcher-forward-$(date +%s%N)-$$" \
        --v-mps "$speed" \
        --omega-rad-s 0 \
        --max-v-mps "$speed" \
        --max-omega-rad-s 0.60
}

_roomcruise_start() {
    _start_active "roomcruise" \
        python3 -m v3.control_cli explore \
        --command-id "launcher-roomcruise-$(date +%s%N)-$$"
}

main() {
    case "${1:-} ${2:-}" in
        "runtime start")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _start_runtime
            ;;
        "runtime stop")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _stop_runtime
            ;;
        "runtime status")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _print_status
            ;;
        "runtime diag")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _print_diag
            ;;
        "forward start")
            [[ $# -le 3 ]] || { usage; return 2; }
            _forward_start "${3:-0.15}"
            ;;
        "roomcruise start")
            [[ $# -eq 2 ]] || { usage; return 2; }
            _roomcruise_start
            ;;
        "stop ")
            [[ $# -le 2 ]] || { usage; return 2; }
            _robot_stop
            [[ "${2:-}" == "--quiet" ]] || echo "robot: STOP published"
            ;;
        "panic --quiet")
            _panic
            ;;
        "panic ")
            _panic
            echo "robot: STOP + runtime shutdown requested"
            ;;
        "help "|"--help "|" -h")
            usage
            ;;
        *)
            usage
            return 2
            ;;
    esac
}

main "$@"
